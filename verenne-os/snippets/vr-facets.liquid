{%- doc -%}
  Storefront filtering and sorting bar for collection and search results, in the theme's underline style.
  Changes submit the form (assets/vr-app.js); the Apply button covers visitors without JavaScript.

  @param {object} results - The collection or search object
  @param {string} url - Page URL the form submits to
  @param {string} [terms] - Search terms to keep, on the search page
{%- enddoc -%}
{%- liquid
  assign sort_by = results.sort_by | default: results.default_sort_by
  assign active_count = 0
  for filter in results.filters
    assign active_count = active_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != null or filter.max_value.value != null
        assign active_count = active_count | plus: 1
      endif
    endif
  endfor
-%}
<form action="{{ url }}" method="get" data-vr-facets class="mt-6">
  {%- if terms != blank -%}
    <input type="hidden" name="q" value="{{ terms | escape }}">
    <input type="hidden" name="options[prefix]" value="last">
  {%- endif -%}
  <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-3">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
      {%- for filter in results.filters -%}
        <details class="group/filter relative" data-vr-filter>
          <summary class="flex cursor-pointer list-none items-center gap-2 py-1 text-[15px] text-[var(--text-secondary)] transition-colors hover:text-[var(--accent)] [&::-webkit-details-marker]:hidden">
            {{ filter.label }}
            {%- if filter.active_values.size > 0 %} <span class="font-mono text-[11px] text-[var(--accent)]">({{ filter.active_values.size }})</span>{% endif -%}
            {% render 'vr-icon', name: 'plus', class: 'h-3 w-3 transition-transform duration-500 group-open/filter:rotate-45' %}
          </summary>
          <div class="absolute left-0 top-full z-30 mt-2 min-w-64 max-w-80 border border-[var(--border-strong)] bg-[var(--bg-primary)] p-5 shadow-2xl">
            {%- case filter.type -%}
              {%- when 'price_range' -%}
                <div class="flex items-center gap-3 text-[14px]">
                  <label class="flex items-center gap-1">
                    <span class="text-[var(--text-muted)]">{{ cart.currency.symbol }}</span>
                    <input
                      type="number"
                      name="{{ filter.min_value.param_name }}"
                      value="{{ filter.min_value.value | money_without_currency | remove: ',' }}"
                      placeholder="0"
                      min="0"
                      class="w-20 border border-[var(--border-subtle)] bg-transparent px-2 py-1.5"
                      aria-label="Minimum price"
                    >
                  </label>
                  <span class="text-[var(--text-muted)]">–</span>
                  <label class="flex items-center gap-1">
                    <span class="text-[var(--text-muted)]">{{ cart.currency.symbol }}</span>
                    <input
                      type="number"
                      name="{{ filter.max_value.param_name }}"
                      value="{{ filter.max_value.value | money_without_currency | remove: ',' }}"
                      placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}"
                      min="0"
                      class="w-20 border border-[var(--border-subtle)] bg-transparent px-2 py-1.5"
                      aria-label="Maximum price"
                    >
                  </label>
                </div>
              {%- else -%}
                <ul class="max-h-72 space-y-2 overflow-y-auto" data-lenis-prevent>
                  {%- for value in filter.values -%}
                    <li>
                      <label class="flex cursor-pointer items-center gap-3 text-[14px] {% if value.count == 0 and value.active == false %}opacity-40{% endif %}">
                        <input
                          type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          {% if value.active %}checked{% endif %}
                          {% if value.count == 0 and value.active == false %}disabled{% endif %}
                          class="h-4 w-4 accent-[var(--accent)]"
                        >
                        <span class="flex-1">{{ value.label }}</span>
                        <span class="font-mono text-[11px] text-[var(--text-muted)]">{{ value.count }}</span>
                      </label>
                    </li>
                  {%- endfor -%}
                </ul>
            {%- endcase -%}
            <noscript><button type="submit" class="mt-4 border border-[var(--border-strong)] px-4 py-2 text-[12px]">Apply</button></noscript>
          </div>
        </details>
      {%- endfor -%}
    </div>

    <div class="flex items-center gap-4 text-[15px]">
      <span class="label">{{ results.products_count | default: results.results_count }} {% if results.products_count == 1 or results.results_count == 1 %}result{% else %}results{% endif %}</span>
      <label class="flex items-center gap-2">
        <span class="text-[var(--text-secondary)]">Sort</span>
        <select name="sort_by" class="cursor-pointer bg-transparent py-1 underline decoration-1 underline-offset-[6px]" aria-label="Sort by">
          {%- for option in results.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </label>
    </div>
  </div>

  {%- if active_count > 0 -%}
    <div class="mt-4 flex flex-wrap items-center gap-2">
      {%- for filter in results.filters -%}
        {%- for value in filter.active_values -%}
          <a href="{{ value.url_to_remove }}" class="inline-flex items-center gap-2 rounded-none border border-[var(--border-subtle)] px-3 py-1 text-[13px] transition-colors hover:border-[var(--border-strong)]">
            {{ filter.label }}: {{ value.label }} {% render 'vr-icon', name: 'x', class: 'h-3 w-3' %}
          </a>
        {%- endfor -%}
        {%- if filter.type == 'price_range' -%}
          {%- if filter.min_value.value != null or filter.max_value.value != null -%}
            <a href="{{ filter.url_to_remove }}" class="inline-flex items-center gap-2 rounded-none border border-[var(--border-subtle)] px-3 py-1 text-[13px] transition-colors hover:border-[var(--border-strong)]">
              {{ filter.min_value.value | default: 0 | money_without_trailing_zeros }}–{{ filter.max_value.value | default: filter.range_max | money_without_trailing_zeros }} {% render 'vr-icon', name: 'x', class: 'h-3 w-3' %}
            </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      <a href="{{ url }}{% if terms != blank %}?q={{ terms | url_encode }}{% endif %}" class="ml-2 text-[13px] underline underline-offset-4 hover:text-[var(--accent)]">Clear all</a>
    </div>
  {%- endif -%}
</form>
