{%- doc -%}
  Product card in the home page grid's style: photo, name, subtitle, price and an add-to-bag link.

  @param {product} product - The product to show
  @param {string} [sizes] - Image sizes attribute
  @param {boolean} [eager] - Load the image eagerly
{%- enddoc -%}
{%- liquid
  assign d = product.metafields.verenne.details.value
  assign first_word = product.title | split: ' ' | first
  if first_word contains 'N°'
    assign name = product.title | remove_first: first_word | strip
  else
    assign name = product.title
  endif
  assign subtitle = d.subtitle | default: product.type
  assign variant = product.selected_or_first_available_variant
  if eager
    assign loading = 'eager'
  else
    assign loading = 'lazy'
  endif
-%}
<li class="flex flex-col">
  <a href="{{ product.url }}" class="group flex flex-1 flex-col text-left" aria-label="{{ 'vr.product.view_named' | t | replace: '[product]', product.title | escape }}">
    <span class="relative block overflow-hidden bg-[var(--bg-secondary)] aspect-[4/5]">
      {%- if product.featured_image -%}
        {%- assign alt = product.title | append: ' — ' | append: subtitle -%}
        {%- assign img_sizes = sizes | default: '(max-width: 1024px) 50vw, 25vw' -%}
        {{
          product.featured_image
          | image_url: width: 1200
          | image_tag:
            widths: '320, 600, 900, 1200',
            sizes: img_sizes,
            loading: loading,
            alt: alt,
            draggable: 'false',
            class: 'select-none absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]'
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'absolute inset-0 h-full w-full text-[var(--text-muted)]' }}
      {%- endif -%}
    </span>
    <span class="mt-4 block font-serif leading-tight text-[22px]">{{ name }}</span>
    {%- if subtitle != blank -%}
      <span class="mt-1 block text-[14px] text-[var(--text-secondary)]">{{ subtitle }}</span>
    {%- endif -%}
  </a>
  <div class="mt-3 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
    <span class="text-[15px] tabular-nums">
      {%- assign price = product.price | money_without_trailing_zeros -%}
      {%- if product.price_varies -%}{{ 'vr.product.from' | t | replace: '[price]', price }}{%- else -%}{{ price }}{%- endif -%}
      {%- if product.compare_at_price > product.price %} <s class="ml-1 text-[13px] text-[var(--text-muted)]">{{ product.compare_at_price | money_without_trailing_zeros }}</s>{% endif -%}
    </span>
    {%- if product.available -%}
      <button type="button" data-vr-add="{{ product.handle }}" class="text-[14px] underline decoration-1 underline-offset-[5px] hover:text-[var(--accent)]" aria-label="{{ 'vr.product.add_named' | t | replace: '[product]', name | escape }}">{{ 'vr.product.add' | t }}</button>
    {%- else -%}
      <span class="text-[14px] text-[var(--text-muted)]">{{ 'vr.product.sold_out' | t }}</span>
    {%- endif -%}
  </div>
  {%- if variant.unit_price_measurement -%}
    <p class="mt-1 text-[12px] text-[var(--text-muted)]">
      {{ variant.unit_price | money }}/{% if variant.unit_price_measurement.reference_value != 1 %}{{ variant.unit_price_measurement.reference_value }}{% endif %}{{ variant.unit_price_measurement.reference_unit }}
    </p>
  {%- endif -%}
</li>
