{%- comment -%} All collections, as large photo cards in the grid style. {%- endcomment -%}
{%- paginate collections by 24 -%}
  <section class="tone-light px-5 pb-20 pt-[185px] sm:px-10 sm:pb-28 sm:pt-[217px]" aria-labelledby="collections-title-{{ section.id }}">
    <div class="mx-auto max-w-[1600px]">
      <h1 id="collections-title-{{ section.id }}" class="border-b border-[var(--border-strong)] pb-6 font-serif text-[clamp(2.6rem,5.5vw,5.4rem)] leading-none tracking-[-0.02em]">{{ section.settings.heading }}</h1>
      <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-12 lg:grid-cols-4 lg:gap-x-6">
        {%- for c in collections -%}
          {%- assign image = c.featured_image | default: c.products.first.featured_image -%}
          <li>
            <a href="{{ c.url }}" class="group block">
              <span class="relative block aspect-[4/5] overflow-hidden bg-[var(--bg-secondary)]">
                {%- if image -%}
                  {{ image | image_url: width: 1200 | image_tag: widths: '320, 600, 900, 1200', sizes: '(max-width: 1024px) 50vw, 25vw', loading: 'lazy', class: 'absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]' }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'absolute inset-0 h-full w-full text-[var(--text-muted)]' }}
                {%- endif -%}
              </span>
              <span class="mt-4 block font-serif text-[22px] leading-tight group-hover:italic">{{ c.title }}</span>
              <span class="mt-1 block text-[14px] text-[var(--text-secondary)]">{% if c.products_count == 1 %}{{ 'vr.collection.formulation' | t }}{% else %}{{ 'vr.collection.formulations' | t | replace: '[count]', c.products_count }}{% endif %}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'vr-pagination', paginate: paginate %}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection list",
  "class": "vr-section-list-collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }
  ]
}
{% endschema %}
