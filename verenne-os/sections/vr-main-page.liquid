{%- comment -%} Page: large serif title and rich text content. {%- endcomment -%}
<section class="tone-light px-5 pb-20 pt-[185px] sm:px-10 sm:pb-28 sm:pt-[217px]" aria-labelledby="page-title-{{ section.id }}">
  <div class="mx-auto max-w-[1600px]">
    <h1 id="page-title-{{ section.id }}" class="border-b border-[var(--border-strong)] pb-6 font-serif text-[clamp(2.6rem,5.5vw,5.4rem)] leading-none tracking-[-0.02em]">{{ page.title }}</h1>
    {%- if page.content != blank -%}
      <div class="vr-rte mt-10 max-w-2xl">{{ page.content }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "class": "vr-section-main-page",
  "settings": []
}
{% endschema %}
