{%- comment -%} Page not found. {%- endcomment -%}
<section class="tone-light grid min-h-[100svh] place-items-center px-5 pt-[105px] sm:px-10" aria-labelledby="notfound-title-{{ section.id }}">
  <div class="text-center">
    <p class="label">404</p>
    <h1 id="notfound-title-{{ section.id }}" class="mt-4 font-serif text-[clamp(3rem,8vw,7rem)] leading-[0.94] tracking-[-0.03em]">
      {{ section.settings.heading }} <em class="block">{{ section.settings.heading_italic }}</em>
    </h1>
    <p class="mx-auto mt-6 max-w-md text-[17px] leading-relaxed text-[var(--text-secondary)]">{{ section.settings.text }}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-6">
      <a href="{{ routes.root_url }}" class="group relative inline-flex items-center justify-center gap-2 overflow-hidden px-7 py-4 text-[15px] font-medium transition-colors duration-500 bg-[var(--text-primary)] text-[var(--accent-ink)]">
        <span aria-hidden="true" class="absolute inset-0 translate-y-[101%] transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-y-0 bg-[var(--accent)]"></span>
        <span class="relative z-10 inline-flex items-center gap-2">{{ section.settings.button }}</span>
      </a>
      <a href="{{ routes.search_url }}" class="text-[15px] underline decoration-1 underline-offset-[6px] hover:text-[var(--accent)]">Search the shop</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page not found",
  "class": "vr-section-404",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Lost," },
    { "type": "text", "id": "heading_italic", "label": "Heading second line", "default": "in the garden." },
    { "type": "text", "id": "text", "label": "Text", "default": "The page you're looking for has moved or never grew here." },
    { "type": "text", "id": "button", "label": "Button label", "default": "Back to Verenne" }
  ]
}
{% endschema %}
