{%- comment -%} Footer: newsletter, brand, three link columns, badges and signature. {%- endcomment -%}
{%- liquid
  assign shop_links = 'Cleanse · 4 Formulas:collection,Treat · 4 Formulas:collection,Hydrate · 4 Formulas:collection,Restore · 4 Formulas:collection' | split: ','
  assign about_links = 'Why Verenne:manifesto,How we distil:manifesto,Our Growers:origins,Skin Care Steps:collection' | split: ','
  assign help_links = 'Shipping:faq,30-day returns:faq' | split: ','
-%}
<footer class="relative bg-[var(--bg-primary)] border-t border-[var(--border-subtle)] text-[var(--text-primary)] overflow-hidden">
  {%- comment -%} 1. Newsletter {%- endcomment -%}
  <div class="border-b border-[var(--border-subtle)] px-5 py-16 sm:px-10 sm:py-20">
    <div class="mx-auto max-w-[1600px] grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-6 space-y-3">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)] animate-pulse"></span>
          <p class="label text-[var(--accent)] font-semibold tracking-[0.2em]">{{ section.settings.newsletter_label }}</p>
        </div>
        <h3 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-light leading-tight">
          {{ section.settings.newsletter_heading }} <em class="text-[var(--accent)] italic">{{ section.settings.newsletter_heading_italic }}</em>
        </h3>
        <p class="text-[13px] text-[var(--text-secondary)] font-light max-w-md leading-relaxed">
          {{ section.settings.newsletter_text }}
        </p>
      </div>

      <div class="lg:col-span-6">
        {%- form 'customer', class: 'flex flex-col sm:flex-row gap-3 max-w-lg lg:ml-auto' -%}
          {%- assign subscribed = form.posted_successfully? -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="relative flex-1">
            <input
              type="email"
              name="contact[email]"
              required
              placeholder="Enter your email address..."
              {% if subscribed %}disabled{% endif %}
              class="w-full h-13 px-5 rounded-none border border-[var(--border-strong)] bg-[var(--bg-secondary)]/60 text-[14px] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--text-primary)] transition-colors"
            >
          </div>
          <button
            type="submit"
            class="h-13 px-8 rounded-none bg-[var(--text-primary)] text-[var(--accent-ink)] font-mono text-[11px] uppercase tracking-widest font-semibold flex items-center justify-center gap-2 hover:bg-[var(--accent)] hover:text-black transition-all cursor-pointer shrink-0"
          >
            {%- if subscribed -%}
              {% render 'vr-icon', name: 'check', class: 'w-4 h-4 text-emerald-600' %}
              <span>Subscribed</span>
            {%- else -%}
              <span>Subscribe</span>
              {% render 'vr-icon', name: 'arrow-right', class: 'w-3.5 h-3.5' %}
            {%- endif -%}
          </button>
        {%- endform -%}
        <p class="mt-3 text-[11px] font-mono text-[var(--text-muted)] lg:text-right" data-vr-newsletter-note>
          {%- if subscribed -%}Welcome to the Maison circle. Your confirmation is in flight.{%- else -%}Strict zero-spam policy. Unsubscribe at any time with a single tap.{%- endif -%}
        </p>
      </div>
    </div>
  </div>

  {%- comment -%} 2. Sitemap {%- endcomment -%}
  <div class="px-5 py-16 sm:px-10 sm:py-20">
    <div class="mx-auto max-w-[1600px] grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 lg:gap-8">
      <div class="lg:col-span-4 space-y-6">
        {% render 'vr-logo', mark_class: 'h-8 w-8', name: section.settings.logo_text, tagline: section.settings.tagline %}
        <p class="text-[13px] text-[var(--text-secondary)] font-light leading-relaxed max-w-sm">
          {{ section.settings.about }}
        </p>

        <div class="space-y-2 pt-2">
          <div class="flex items-center gap-2 text-[11px] font-mono text-[var(--text-secondary)]">
            {% render 'vr-icon', name: 'map-pin', class: 'w-3.5 h-3.5 text-[var(--accent)] shrink-0' %}
            <span>{{ section.settings.address }}</span>
          </div>
          <div class="flex items-center gap-2 text-[11px] font-mono text-[var(--text-secondary)]">
            {% render 'vr-icon', name: 'clock', class: 'w-3.5 h-3.5 text-[var(--accent)] shrink-0' %}
            <span>{{ section.settings.hours }}{% if section.settings.show_clock %} (CET <span data-vr-grasse-time></span>){% endif %}</span>
          </div>
        </div>
      </div>

      {%- for col in (1..3) -%}
        {%- case col -%}
          {%- when 1 -%}{%- assign title = section.settings.menu_1_title -%}{%- assign col_menu = section.settings.menu_1 -%}{%- assign col_links = shop_links -%}
          {%- when 2 -%}{%- assign title = section.settings.menu_2_title -%}{%- assign col_menu = section.settings.menu_2 -%}{%- assign col_links = about_links -%}
          {%- else -%}{%- assign title = section.settings.menu_3_title -%}{%- assign col_menu = section.settings.menu_3 -%}{%- assign col_links = help_links -%}
        {%- endcase -%}
        <div class="lg:col-span-2 space-y-4">
          <p class="font-mono text-[10px] uppercase tracking-widest text-[var(--accent)] font-semibold">{{ title }}</p>
          <ul class="space-y-2.5">
            {%- if col_menu.links.size > 0 -%}
              {%- for link in col_menu.links -%}
                {%- assign anchor = link.url | split: '#' | last -%}
                <li>
                  <a href="{{ link.url }}" {% if link.url contains '#' %}data-vr-go="{{ anchor }}"{% endif %} class="text-[13px] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors text-left cursor-pointer">{{ link.title }}</a>
                </li>
              {%- endfor -%}
            {%- else -%}
              {%- for link in col_links -%}
                {%- assign parts = link | split: ':' -%}
                <li>
                  <button type="button" data-vr-go="{{ parts[1] }}" class="text-[13px] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors text-left cursor-pointer">{{ parts[0] }}</button>
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
      {%- endfor -%}

      <div class="lg:col-span-2 space-y-4">
        <p class="font-mono text-[10px] uppercase tracking-widest text-[var(--accent)] font-semibold">{{ section.settings.badges_title }}</p>
        <div class="space-y-3 text-[12px] font-mono text-[var(--text-secondary)]">
          <div class="flex items-center gap-2 p-2.5 rounded-none border border-[var(--border-subtle)] bg-[var(--bg-secondary)]/40">
            {% render 'vr-icon', name: 'leaf', class: 'w-4 h-4 text-[var(--accent)] shrink-0' %}
            <span>{{ section.settings.badge_1 }}</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-none border border-[var(--border-subtle)] bg-[var(--bg-secondary)]/40">
            {% render 'vr-icon', name: 'sparkles', class: 'w-4 h-4 text-[var(--accent)] shrink-0' %}
            <span>{{ section.settings.badge_2 }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} 3. Signature {%- endcomment -%}
  <div class="border-t border-[var(--border-subtle)]/60 py-8 px-5 sm:px-10 select-none">
    <div class="mx-auto max-w-[1600px] flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        {% render 'vr-mark', class: 'h-6 w-6 text-[var(--accent)]' %}
        <span class="font-serif text-lg tracking-[0.1em] uppercase text-[var(--text-primary)]">{{ section.settings.signature | default: shop.name }}</span>
        <span class="font-mono text-[10px] text-[var(--text-muted)]">·</span>
        <span class="font-serif text-sm italic text-[var(--accent)]">{{ section.settings.motto }}</span>
      </div>

      <div class="flex items-center gap-3 text-[11px] font-mono">
        <div class="flex items-center gap-1 rounded-none border border-[var(--border-subtle)] bg-[var(--bg-secondary)] px-3 py-1">
          {% render 'vr-icon', name: 'globe', class: 'w-3 h-3 text-[var(--text-muted)]' %}
          <button type="button" data-vr-lang class="hover:text-[var(--accent)] transition-colors cursor-pointer">EN</button>
          <span class="text-[var(--text-muted)]">/</span>
          <button type="button" data-vr-currency class="hover:text-[var(--accent)] transition-colors cursor-pointer">USD ($)</button>
        </div>
        <span class="text-[10px] text-[var(--text-muted)]">© {{ 'now' | date: '%Y' }} {{ section.settings.copyright | default: shop.name }}</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "vr-section-footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "header", "content": "Newsletter" },
    { "type": "text", "id": "newsletter_label", "label": "Eyebrow", "default": "The Seasonal Gazette" },
    { "type": "text", "id": "newsletter_heading", "label": "Heading", "default": "Four letters a year. Harvest notes, private batches," },
    { "type": "text", "id": "newsletter_heading_italic", "label": "Heading ending", "info": "Shown in italics in the accent color.", "default": "nothing else." },
    { "type": "textarea", "id": "newsletter_text", "label": "Text", "default": "Subscribers receive early access to seasonal copper-still harvests and limited single-estate distillations before public release." },
    { "type": "header", "content": "Brand" },
    { "type": "text", "id": "logo_text", "label": "Logo name", "info": "Leave blank to use the store name." },
    { "type": "text", "id": "tagline", "label": "Logo tagline", "default": "Paris · Grasse" },
    { "type": "textarea", "id": "about", "label": "About text", "default": "Verenne is an independent botanical skincare house in Grasse, built on slow copper distillation, single-origin plant oils and dark glass." },
    { "type": "text", "id": "address", "label": "Address", "default": "12 Rue de l’Oratoire, 06130 Grasse, France" },
    { "type": "text", "id": "hours", "label": "Opening hours", "default": "Atelier Hours: Mon–Sat 09:00–18:00" },
    { "type": "checkbox", "id": "show_clock", "label": "Show local time in Paris", "default": true },
    { "type": "header", "content": "Links" },
    { "type": "text", "id": "menu_1_title", "label": "First column heading", "default": "Shop" },
    { "type": "link_list", "id": "menu_1", "label": "First column menu", "default": "footer" },
    { "type": "text", "id": "menu_2_title", "label": "Second column heading", "default": "About" },
    { "type": "link_list", "id": "menu_2", "label": "Second column menu" },
    { "type": "text", "id": "menu_3_title", "label": "Third column heading", "default": "Help" },
    { "type": "link_list", "id": "menu_3", "label": "Third column menu" },
    { "type": "header", "content": "Badges and signature" },
    { "type": "text", "id": "badges_title", "label": "Badges heading", "default": "Integrity Standards" },
    { "type": "text", "id": "badge_1", "label": "First badge", "default": "100% Recyclable Glass" },
    { "type": "text", "id": "badge_2", "label": "Second badge", "default": "Carbon Neutral Freight" },
    { "type": "text", "id": "signature", "label": "Signature name", "default": "Maison Verenne" },
    { "type": "text", "id": "motto", "label": "Signature motto", "default": "Formulata Tarde · Natura Vivens" },
    { "type": "text", "id": "copyright", "label": "Copyright text", "default": "Verenne Inc. All rights reserved." }
  ]
}
{% endschema %}
