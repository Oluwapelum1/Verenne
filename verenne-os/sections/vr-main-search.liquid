{%- comment -%} Search page: large serif search field with predictive suggestions, filters and results in the grid style. {%- endcomment -%}
{%- paginate search.results by section.settings.per_page -%}
  <section class="tone-light px-5 pb-20 pt-[185px] sm:px-10 sm:pb-28 sm:pt-[217px]" aria-labelledby="search-title-{{ section.id }}">
    <div class="mx-auto max-w-[1600px]">
      <div class="border-b border-[var(--border-strong)] pb-6">
        <h1 id="search-title-{{ section.id }}" class="font-serif text-[clamp(2.6rem,5.5vw,5.4rem)] leading-none tracking-[-0.02em]">
          {%- if search.performed -%}
            {{ section.settings.results_heading }} <em>“{{ search.terms }}”</em>
          {%- else -%}
            {{ section.settings.heading }}
          {%- endif -%}
        </h1>

        <form action="{{ routes.search_url }}" method="get" role="search" class="relative mt-8 max-w-2xl" data-vr-predictive>
          <label for="search-input-{{ section.id }}" class="sr-only">Search</label>
          <input
            id="search-input-{{ section.id }}"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ section.settings.placeholder | escape }}"
            autocomplete="off"
            role="combobox"
            aria-expanded="false"
            aria-controls="predictive-{{ section.id }}"
            class="w-full border-b border-[var(--border-strong)] bg-transparent py-3 pr-24 font-serif text-3xl placeholder:text-[var(--text-muted)] focus:border-[var(--text-primary)] focus:outline-none [&::-webkit-search-cancel-button]:appearance-none"
            data-vr-predictive-input
          >
          <input type="hidden" name="options[prefix]" value="last">
          <button type="submit" class="absolute bottom-3 right-0 text-[15px] underline decoration-1 underline-offset-[6px] hover:text-[var(--accent)]">Search</button>
          <div id="predictive-{{ section.id }}" class="absolute inset-x-0 top-full z-40 mt-2" data-vr-predictive-results hidden></div>
        </form>

        {%- if search.performed and section.settings.show_filters and search.filters.size > 0 -%}
          {% render 'vr-facets', results: search, url: routes.search_url, terms: search.terms %}
        {%- endif -%}
      </div>

      {%- if search.performed -%}
        {%- if search.results_count > 0 -%}
          <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-12 lg:grid-cols-4 lg:gap-x-6">
            {%- for item in search.results -%}
              {%- case item.object_type -%}
                {%- when 'product' -%}
                  {% render 'vr-product-card', product: item %}
                {%- else -%}
                  <li class="flex flex-col">
                    <a href="{{ item.url }}" class="group flex flex-1 flex-col border border-[var(--border-subtle)] p-5 transition-colors hover:border-[var(--border-strong)]">
                      <span class="label">{% if item.object_type == 'article' %}Journal{% else %}Page{% endif %}</span>
                      <span class="mt-3 block font-serif text-[22px] leading-tight group-hover:italic">{{ item.title }}</span>
                      <span class="mt-2 block text-[14px] text-[var(--text-secondary)]">{{ item.content | strip_html | truncatewords: 22 }}</span>
                    </a>
                  </li>
              {%- endcase -%}
            {%- endfor -%}
          </ul>
        {%- else -%}
          <div class="py-24 text-center">
            <p class="font-serif text-3xl">Nothing matched “{{ search.terms }}”.</p>
            <p class="mt-2 text-[14px] text-[var(--text-secondary)]">Check the spelling or try a broader word.</p>
          </div>
        {%- endif -%}
        {% render 'vr-pagination', paginate: paginate %}
      {%- endif -%}
    </div>
  </section>

  <script type="application/json" data-vr-products>
    [
      {%- assign first = true -%}
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}
          {%- unless first %},{% endunless -%}
          {% render 'vr-product-json', product: item, index: forloop.index %}
          {%- assign first = false -%}
        {%- endif -%}
      {%- endfor -%}
    ]
  </script>
{%- endpaginate -%}

{% schema %}
{
  "name": "Search results",
  "class": "vr-section-main-search",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Search" },
    { "type": "text", "id": "results_heading", "label": "Results heading", "default": "Results for" },
    { "type": "text", "id": "placeholder", "label": "Search field placeholder", "default": "Search formulations, botanicals, rituals" },
    { "type": "range", "id": "per_page", "label": "Results per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "checkbox", "id": "show_filters", "label": "Show filtering and sorting", "default": true }
  ]
}
{% endschema %}
