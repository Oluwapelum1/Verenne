{%- comment -%} Blog: article cards in the collection grid's style, with tag filter and pagination. {%- endcomment -%}
{%- paginate blog.articles by section.settings.per_page -%}
  <section class="tone-light px-5 pb-20 pt-[185px] sm:px-10 sm:pb-28 sm:pt-[217px]" aria-labelledby="blog-title-{{ section.id }}">
    <div class="mx-auto max-w-[1600px]">
      <div class="flex flex-col justify-between gap-6 border-b border-[var(--border-strong)] pb-6 lg:flex-row lg:items-end">
        <h1 id="blog-title-{{ section.id }}" class="font-serif text-[clamp(2.6rem,5.5vw,5.4rem)] leading-none tracking-[-0.02em]">{{ blog.title }}</h1>
        {%- if blog.all_tags.size > 0 and section.settings.show_tags -%}
          <div class="flex flex-wrap gap-x-6 gap-y-2" role="group" aria-label="{{ 'vr.blog.topics' | t }}">
            <a href="{{ blog.url }}" class="py-1 text-[15px] underline-offset-[6px] transition-colors hover:text-[var(--accent)] {% if current_tags == blank %}underline decoration-1{% else %}text-[var(--text-secondary)]{% endif %}">{{ 'vr.blog.all' | t }}</a>
            {%- for tag in blog.all_tags -%}
              <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="py-1 text-[15px] underline-offset-[6px] transition-colors hover:text-[var(--accent)] {% if current_tags contains tag %}underline decoration-1{% else %}text-[var(--text-secondary)]{% endif %}">{{ tag }}</a>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <ul class="mt-10 grid grid-cols-1 gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {%- for article in blog.articles -%}
          {% render 'vr-article-card', article: article, eager: forloop.first %}
        {%- else -%}
          <li class="py-24 text-center sm:col-span-2 lg:col-span-3"><p class="font-serif text-3xl">{{ 'vr.blog.empty' | t }}</p></li>
        {%- endfor -%}
      </ul>

      {% render 'vr-pagination', paginate: paginate %}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog posts",
  "class": "vr-section-main-blog",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Articles per page", "min": 3, "max": 24, "step": 3, "default": 9 },
    { "type": "checkbox", "id": "show_tags", "label": "Show topic filter", "default": true }
  ]
}
{% endschema %}
