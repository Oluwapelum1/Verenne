{%- comment -%} Store password page: brand, opening message, newsletter sign-up and password entry. {%- endcomment -%}
<section class="grid min-h-[100svh] grid-cols-1 lg:grid-cols-12">
  <div class="flex flex-col justify-between gap-16 px-5 py-10 sm:px-10 sm:py-14 lg:col-span-7">
    {% render 'vr-logo', mark_class: 'h-8 w-8', tagline: section.settings.tagline %}

    <div>
      <p class="label">{{ section.settings.label }}</p>
      <h1 class="mt-4 font-serif text-[clamp(3rem,7vw,7rem)] leading-[0.94] tracking-[-0.03em]">
        {{ section.settings.heading }} <em class="block text-[var(--accent)]">{{ section.settings.heading_italic }}</em>
      </h1>
      {%- if shop.password_message != blank -%}
        <p class="mt-6 max-w-md text-[17px] leading-relaxed text-[var(--text-secondary)]">{{ shop.password_message }}</p>
      {%- endif -%}

      {%- form 'customer', class: 'mt-10 flex max-w-lg flex-col gap-3 sm:flex-row' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
        {%- if form.posted_successfully? -%}
          <p class="text-[14px] text-[var(--accent)]" role="status">{{ section.settings.signup_success }}</p>
        {%- else -%}
          <label class="flex-1"><span class="sr-only">Email</span><input class="vr-field h-13" type="email" name="contact[email]" placeholder="Enter your email address..." required autocomplete="email"></label>
          <button type="submit" class="flex h-13 shrink-0 items-center justify-center gap-2 px-8 rounded-none bg-[var(--text-primary)] text-[var(--accent-ink)] font-mono text-[11px] uppercase tracking-widest font-semibold transition-all hover:bg-[var(--accent)] hover:text-black">
            {{ section.settings.signup_button }} {% render 'vr-icon', name: 'arrow-right', class: 'w-3.5 h-3.5' %}
          </button>
        {%- endif -%}
      {%- endform -%}
    </div>

    <details class="group max-w-lg">
      <summary class="flex cursor-pointer list-none items-center gap-2 text-[15px] text-[var(--text-secondary)] hover:text-[var(--accent)] [&::-webkit-details-marker]:hidden">
        {{ 'password.title' | t }} {% render 'vr-icon', name: 'plus', class: 'h-3.5 w-3.5 transition-transform duration-500 group-open:rotate-45' %}
      </summary>
      {%- form 'storefront_password', class: 'mt-4 flex flex-col gap-3 sm:flex-row' -%}
        {%- if form.errors -%}
          <div class="text-[13px] text-red-400" role="alert">{{ form.errors | default_errors }}</div>
          <script>document.currentScript.closest('details').open = true;</script>
        {%- endif -%}
        <label class="flex-1"><span class="sr-only">{{ 'password.password' | t }}</span><input class="vr-field h-13" type="password" name="password" placeholder="{{ 'password.password' | t }}" autocomplete="current-password"></label>
        <button type="submit" class="h-13 shrink-0 border border-[var(--border-strong)] px-8 text-[13px] transition-colors hover:bg-[var(--text-primary)] hover:text-[var(--accent-ink)]">{{ 'password.enter' | t }}</button>
      {%- endform -%}
    </details>
  </div>

  <div class="relative min-h-[50vh] overflow-hidden lg:col-span-5 lg:min-h-0">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 1024px) 42vw, 100vw', loading: 'eager', class: 'absolute inset-0 h-full w-full object-cover' }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'absolute inset-0 h-full w-full bg-[var(--bg-secondary)] text-[var(--text-muted)]' }}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "class": "vr-section-password",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Logo tagline", "default": "Paris · Grasse" },
    { "type": "text", "id": "label", "label": "Eyebrow", "default": "Opening soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Distilling" },
    { "type": "text", "id": "heading_italic", "label": "Heading second line", "default": "the first harvest." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "signup_button", "label": "Sign-up button", "default": "Notify me" },
    { "type": "text", "id": "signup_success", "label": "Sign-up success message", "default": "You're on the list. We'll write when the atelier opens." }
  ]
}
{% endschema %}
