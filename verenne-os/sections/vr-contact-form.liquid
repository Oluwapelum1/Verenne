{%- comment -%} Contact form in the footer newsletter's field and button style. {%- endcomment -%}
<section class="tone-light px-5 pb-20 sm:px-10 sm:pb-28" aria-labelledby="contact-title-{{ section.id }}">
  <div class="mx-auto grid max-w-[1600px] grid-cols-1 gap-12 pt-10 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="label">{{ section.settings.label }}</p>
      <h2 id="contact-title-{{ section.id }}" class="mt-4 font-serif text-[clamp(2.2rem,4vw,3.6rem)] leading-[0.95]">
        {{ section.settings.heading }} <em class="text-[var(--accent)]">{{ section.settings.heading_italic }}</em>
      </h2>
      {%- if section.settings.text != blank -%}
        <div class="mt-4 max-w-sm text-[15px] leading-relaxed text-[var(--text-secondary)]">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="lg:col-span-7 lg:col-start-6">
      {%- form 'contact', class: 'space-y-3' -%}
        {%- if form.posted_successfully? -%}
          <p class="flex items-center gap-2 text-[15px] text-[var(--accent)]" role="status">{% render 'vr-icon', name: 'check', class: 'h-4 w-4' %} {{ section.settings.success }}</p>
        {%- endif -%}
        {%- if form.errors -%}<div class="text-[13px] text-red-700" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="block"><span class="sr-only">Name</span><input class="vr-field" type="text" name="contact[name]" placeholder="Name" value="{{ form.name }}" autocomplete="name"></label>
          <label class="block"><span class="sr-only">Email</span><input class="vr-field" type="email" name="contact[email]" placeholder="Email" value="{{ form.email }}" required autocomplete="email"></label>
        </div>
        <label class="block"><span class="sr-only">Phone</span><input class="vr-field" type="tel" name="contact[phone]" placeholder="Phone (optional)" value="{{ form.phone }}" autocomplete="tel"></label>
        <label class="block"><span class="sr-only">Message</span><textarea class="vr-field" name="contact[body]" rows="6" placeholder="Message" required>{{ form.body }}</textarea></label>
        <button type="submit" class="flex h-13 items-center justify-center gap-2 px-8 rounded-none bg-[var(--text-primary)] text-[var(--accent-ink)] font-mono text-[11px] uppercase tracking-widest font-semibold transition-all hover:bg-[var(--accent)] hover:text-black">
          {{ section.settings.button }} {% render 'vr-icon', name: 'arrow-right', class: 'w-3.5 h-3.5' %}
        </button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "class": "vr-section-contact",
  "settings": [
    { "type": "text", "id": "label", "label": "Eyebrow", "default": "Write to us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The atelier" },
    { "type": "text", "id": "heading_italic", "label": "Heading ending", "info": "Shown in italics in the accent color.", "default": "replies within a day." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions about a formula, an order or your ritual. We answer every message by hand.</p>" },
    { "type": "text", "id": "button", "label": "Button label", "default": "Send" },
    { "type": "text", "id": "success", "label": "Success message", "default": "Thank you. We'll reply shortly." }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
