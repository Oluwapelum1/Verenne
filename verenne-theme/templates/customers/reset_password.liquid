<div class="verenne-section verenne-customer-portal" style="padding: 6rem 1.5rem; min-height: 70vh; display: flex; align-items: center; justify-content: center;">
  <div class="verenne-auth-card" style="max-width: 460px; width: 100%; background-color: var(--verenne-bg-surface); border: 1px solid var(--verenne-border-subtle); border-radius: 16px; padding: 3rem 2.5rem; text-align: center;">
    
    <p class="verenne-caption" style="margin-bottom: 0.5rem;">CLIENT SECURITY</p>
    <h1 class="verenne-heading" style="font-size: 2rem; margin-bottom: 1rem;">Reset Password</h1>
    <p class="verenne-body" style="font-size: 0.875rem; color: var(--verenne-text-dim); margin-bottom: 2rem;">
      Enter a new confidential password for your account.
    </p>

    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <div class="verenne-auth-error" style="color: #f87171; font-size: 0.85rem; margin-bottom: 1rem; text-align: left;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div style="margin-bottom: 1.25rem; text-align: left;">
        <label for="password" class="verenne-caption" style="display: block; margin-bottom: 0.4rem;">New Password</label>
        <input
          type="password"
          name="customer[password]"
          id="password"
          class="verenne-input"
          autocomplete="new-password"
          required
        >
      </div>

      <div style="margin-bottom: 1.75rem; text-align: left;">
        <label for="password_confirmation" class="verenne-caption" style="display: block; margin-bottom: 0.4rem;">Confirm Password</label>
        <input
          type="password"
          name="customer[password_confirmation]"
          id="password_confirmation"
          class="verenne-input"
          autocomplete="new-password"
          required
        >
      </div>

      <button type="submit" class="verenne-pill-btn verenne-pill-btn--primary" style="width: 100%;">
        Save New Password
      </button>
    {%- endform -%}

  </div>
</div>

