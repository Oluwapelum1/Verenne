{%- comment -%} VerenneLogo from src/components/ui.jsx. Usage: {% render 'vr-logo', mark_class: 'h-7 w-7' %} {%- endcomment -%}
<div class="inline-flex items-center gap-2.5 ">
  {%- assign mark = mark_class | default: 'h-6 w-6' | append: ' text-[var(--accent)] shrink-0' -%}
  {% render 'vr-mark', class: mark %}
  <div class="flex flex-col text-left">
    <span class="font-serif text-[1.35rem] tracking-[0.06em] leading-none text-[var(--text-primary)] font-normal uppercase">Verenne</span>
    <span class="font-mono text-[7.5px] uppercase tracking-[0.28em] text-[var(--accent)] mt-0.5 leading-none opacity-85">Paris · Grasse</span>
  </div>
</div>
