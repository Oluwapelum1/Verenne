<div class="verenne-section verenne-featured-blog" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="verenne-container">
    <div class="verenne-section-header" style="text-align: {{ section.settings.heading_alignment }}; margin-bottom: 3.5rem;">
      {%- if section.settings.caption != blank -%}
        <p class="verenne-caption">{{ section.settings.caption | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="verenne-heading" style="font-size: clamp(2rem, 3.5vw, 3rem); margin-top: 0.5rem;">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="verenne-body" style="color: var(--verenne-text-dim); max-width: 600px; margin: 0.75rem auto 0;">
          {{ section.settings.subtext | escape }}
        </p>
      {%- endif -%}
    </div>

    <div class="verenne-blog-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem;">
      {%- assign blog = section.settings.blog -%}
      {%- if blog != blank and blog.articles.size > 0 -%}
        {%- for article in blog.articles limit: section.settings.post_limit -%}
          <article class="verenne-article-card">
            <a href="{{ article.url }}" class="verenne-article-card__media-link">
              <div class="verenne-article-card__media">
                {%- if article.image -%}
                  {{
                    article.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      class: 'verenne-article-card__img',
                      alt: article.image.alt | default: article.title | escape
                  }}
                {%- else -%}
                  <div class="verenne-article-card__placeholder">
                    <span>{{ 'now' | date: '%B %Y' }}</span>
                  </div>
                {%- endif -%}
              </div>
            </a>

            <div class="verenne-article-card__content">
              <div class="verenne-article-card__meta">
                <span class="verenne-article-card__date">{{ article.published_at | date: "%B %d, %Y" }}</span>
                {%- if article.author != blank -%}
                  <span class="verenne-article-card__dot">·</span>
                  <span class="verenne-article-card__author">{{ article.author }}</span>
                {%- endif -%}
              </div>

              <h3 class="verenne-article-card__title">
                <a href="{{ article.url }}">{{ article.title | escape }}</a>
              </h3>

              {%- if article.excerpt.size > 0 or article.content.size > 0 -%}
                <p class="verenne-article-card__excerpt">
                  {{ article.excerpt | default: article.content | strip_html | truncatewords: 24 }}
                </p>
              {%- endif -%}

              <a href="{{ article.url }}" class="verenne-article-card__read-more">
                Read Dispatch <span class="verenne-article-card__arrow">→</span>
              </a>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <article class="verenne-article-card">
            <div class="verenne-article-card__media verenne-article-card__placeholder">
              <span>Archival Dispatch #0{{ i }}</span>
            </div>
            <div class="verenne-article-card__content">
              <div class="verenne-article-card__meta">
                <span class="verenne-article-card__date">October 24, 2026</span>
                <span class="verenne-article-card__dot">·</span>
                <span class="verenne-article-card__author">Atelier Grasse</span>
              </div>
              <h3 class="verenne-article-card__title">
                <a href="#">The Extraction of Alpine Gentian at Dawn</a>
              </h3>
              <p class="verenne-article-card__excerpt">
                Observing the bio-chromatography of mountain-harvested polyphenols before first light in Haute-Provence.
              </p>
              <span class="verenne-article-card__read-more">Read Dispatch →</span>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and blog != blank -%}
      <div style="text-align: center; margin-top: 3.5rem;">
        <a href="{{ blog.url }}" class="verenne-pill-btn verenne-pill-btn--outline">
          View All Dispatches →
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Verenne Archival Journal",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "(03) — ARCHIVAL DISPATCHES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Botanical Journal"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Essays on bio-chromatography, seasonal harvests, and formulation science."
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Posts to show",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' button",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Verenne Archival Journal"
    }
  ]
}
{% endschema %}

