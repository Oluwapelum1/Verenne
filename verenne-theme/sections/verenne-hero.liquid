{%- comment -%}
  Verenne Luxury Hero Section
  1:1 Replica of Hero.jsx from https://oluwapelum1.github.io/Verenne/
{%- endcomment -%}

<section id="top" class="verenne-hero-section tone-light" aria-labelledby="hero-title">
  <!-- Left Column: Copy & Actions -->
  <div class="verenne-hero-left">
    <h1 id="hero-title" class="verenne-hero-heading">
      Botanical<br>
      skincare.<br>
      <em class="verenne-hero-italic">made slowly.</em>
    </h1>

    <div class="verenne-hero-bottom">
      <p class="verenne-hero-blurb">
        Sixteen plant-based formulas to cleanse, treat, hydrate and restore your skin. Distilled in small batches in Grasse.
      </p>

      <div class="verenne-hero-ctas">
        <a href="#collection" class="verenne-btn-solid">
          Shop from $56
        </a>
        <a href="#ritual" class="verenne-link-routine">
          See the routine
        </a>
      </div>
    </div>
  </div>

  <!-- Right Column: Full-Height Portrait -->
  <div class="verenne-hero-right">
    <img
      src="{{ 'model_oil_glow.jpg' | asset_url }}"
      alt="A woman pressing a golden facial oil into her cheek — Verenne"
      class="verenne-hero-model-img"
      loading="eager"
      fetchpriority="high"
      width="1400"
      height="1800"
    >
  </div>
</section>

{% schema %}
{
  "name": "Verenne Hero",
  "class": "section-verenne-hero",
  "settings": [],
  "presets": [
    {
      "name": "Verenne Hero"
    }
  ]
}
{% endschema %}
