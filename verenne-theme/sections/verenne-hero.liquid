{%- comment -%}
  Verenne Luxury Hero Section
  Haute-Botanique split editorial layout with large serif typography and studio imagery
{%- endcomment -%}

<section class="verenne-hero" aria-labelledby="verenne-hero-heading-{{ section.id }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="verenne-hero-content">
    {%- if section.settings.caption != blank -%}
      <p class="verenne-caption">{{ section.settings.caption | escape }}</p>
    {%- endif -%}

    <h1 id="verenne-hero-heading-{{ section.id }}" class="verenne-hero-title">
      {{ section.settings.heading | escape }}
      {%- if section.settings.heading_italic != blank -%}
        <em style="display: block; font-style: italic; color: var(--verenne-gold);">
          {{ section.settings.heading_italic | escape }}
        </em>
      {%- endif -%}
    </h1>

    <div class="verenne-hero-footer">
      <p class="verenne-hero-subtext">
        {{ section.settings.subtext | escape }}
      </p>

      <div class="verenne-hero-actions">
        {%- if section.settings.button_text != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="verenne-pill-btn">
            {{ section.settings.button_text | escape }} →
          </a>
        {%- endif -%}

        {%- if section.settings.secondary_text != blank and section.settings.secondary_link != blank -%}
          <a href="{{ section.settings.secondary_link }}" class="verenne-pill-btn verenne-pill-btn--outline">
            {{ section.settings.secondary_text | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="verenne-hero-media">
    {%- if section.settings.image != blank -%}
      {%- assign hero_alt = section.settings.image.alt | default: section.settings.heading | escape -%}
      {{
        section.settings.image
        | image_url: width: 1400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '600, 900, 1200, 1400',
          sizes: '(min-width: 990px) 45vw, 100vw',
          alt: hero_alt,
          class: 'verenne-hero-img'
      }}
    {%- else -%}
      {{
        'model_oil_glow.jpg'
        | asset_url
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          class: 'verenne-hero-img',
          alt: 'A woman pressing a golden facial oil into her cheek — Verenne'
      }}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Verenne Hero",
  "class": "section-verenne-hero",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "default": "HAUTE-BOTANIQUE FORMULATIONS",
      "label": "Caption eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Botanical skincare,",
      "label": "Heading main line"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "default": "made slowly.",
      "label": "Heading accent line"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "default": "Sixteen plant-based formulas to cleanse, treat, hydrate and restore your skin. Distilled in small batches in Grasse.",
      "label": "Subtext description"
    },
    {
      "type": "text",
      "id": "button_text",
      "default": "Shop the collection",
      "label": "Primary button text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_text",
      "default": "Read The Manifesto",
      "label": "Secondary button text"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero studio image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Verenne Hero"
    }
  ]
}
{% endschema %}
