<div class="verenne-section verenne-rich-text" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="verenne-container">
    <div class="verenne-rich-text__content" style="max-width: {{ section.settings.content_width }}px; margin: 0 auto; text-align: {{ section.settings.text_alignment }};">
      {%- if section.settings.caption != blank -%}
        <p class="verenne-caption">{{ section.settings.caption | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="verenne-heading verenne-rich-text__heading" style="font-size: clamp(2rem, 4vw, 3.5rem); line-height: 1.15; margin: 1.5rem 0;">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="verenne-body verenne-rich-text__text" style="font-size: 1.1rem; line-height: 1.8; opacity: 0.85; margin-bottom: 2rem;">
          {{ section.settings.text }}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="verenne-pill-btn verenne-pill-btn--primary">
          {{ section.settings.button_label | escape }}
          <span class="verenne-pill-btn__arrow">→</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.rich-text.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "(01) — MANIFESTO"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We make sixteen formulations and nothing else."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every batch is compounded by hand in Grasse, aged in violet Miron glass, and released in numbered editions of four hundred flacons.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 500,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Maximum content width",
      "default": 800
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore The Manifesto"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Verenne Editorial Statement"
    }
  ]
}
{% endschema %}

