<div class="verenne-section verenne-statutes" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; border-top: 1px solid var(--verenne-border-subtle); border-bottom: 1px solid var(--verenne-border-subtle); background-color: #17110C;">
  <div class="verenne-container">
    <div class="verenne-statutes-grid">
      <!-- Left Column: Manifesto Headline & Description -->
      <div class="verenne-statutes-lead">
        {%- if section.settings.caption != blank -%}
          <p class="verenne-caption">{{ section.settings.caption | escape }}</p>
        {%- endif -%}
        <h2 class="verenne-heading verenne-statutes-title">
          {{ section.settings.heading | escape }}
          {%- if section.settings.heading_italic != blank -%}
            <em>{{ section.settings.heading_italic | escape }}</em>
          {%- endif -%}
        </h2>
        {%- if section.settings.subtext != blank -%}
          <p class="verenne-body verenne-statutes-subtext">
            {{ section.settings.subtext | escape }}
          </p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <div style="margin-top: 2rem;">
            <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="verenne-pill-btn verenne-pill-btn--outline">
              {{ section.settings.button_label | escape }} →
            </a>
          </div>
        {%- endif -%}
      </div>

      <!-- Right Column: Standards List with Gold Numbers -->
      <div class="verenne-statutes-list-wrap">
        <ul class="verenne-statutes-list" role="list">
          {%- for block in section.blocks -%}
            <li class="verenne-statute-item" {{ block.shopify_attributes }}>
              <div class="verenne-statute-num">{{ block.settings.number | escape }}</div>
              <div class="verenne-statute-detail">
                <h3 class="verenne-statute-name">{{ block.settings.title | escape }}</h3>
                <p class="verenne-statute-text">{{ block.settings.text | escape }}</p>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Four Inviolable Statutes",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "HAUTE-APOTHECARY STANDARDS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We make sixteen formulations and "
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Italic heading accent",
      "default": "nothing else."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Wild plants, distilled soon after picking and bottled in violet Miron glass. Slow by design, because skin is too."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Read The Grasse Codex"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "statute",
      "name": "Statute",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Metric / Number",
          "default": "16"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "A focused range"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Four formulas each to cleanse, treat, hydrate and restore. Nothing beyond that."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Verenne Four Statutes",
      "blocks": [
        {
          "type": "statute",
          "settings": {
            "number": "16",
            "title": "A focused range",
            "text": "Four formulas each to cleanse, treat, hydrate and restore. Nothing beyond that."
          }
        },
        {
          "type": "statute",
          "settings": {
            "number": "72h",
            "title": "Field to still",
            "text": "Plants are picked by hand at dawn and distilled in copper stills within 72 hours."
          }
        },
        {
          "type": "statute",
          "settings": {
            "number": "4",
            "title": "Known origins",
            "text": "Corsica, Morocco, the Horn of Africa and Grasse, from the same organic growers every season."
          }
        },
        {
          "type": "statute",
          "settings": {
            "number": "0",
            "title": "Synthetic fragrance",
            "text": "Zero silicones, parabens, phthalates or artificial colouring in any formulation."
          }
        }
      ]
    }
  ]
}
{% endschema %}

