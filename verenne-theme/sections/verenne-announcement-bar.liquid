{%- comment -%}
  Verenne Luxury Announcement Bar
  Rotating ticker or static announcement with glowing dot and customizable links
{%- endcomment -%}

<div class="verenne-announcement" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
  <div class="page-width">
    {%- for block in section.blocks -%}
      <div class="verenne-announcement-item" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">
            {{ block.settings.text | escape }}
          </a>
        {%- else -%}
          <span>{{ block.settings.text | escape }}</span>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Verenne Announcement Bar",
  "class": "section-announcement-bar",
  "max_blocks": 5,
  "settings": [],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Complimentary carbon-neutral shipping on orders over $150",
          "label": "Announcement text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "announcement",
        "settings": {
          "text": "Complimentary carbon-neutral shipping on orders over $150"
        }
      }
    ]
  }
}
{% endschema %}

