<footer class="verenne-footer" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="verenne-container">
    <div class="verenne-footer__grid">
      <!-- Brand & Mission Column -->
      <div class="verenne-footer__col verenne-footer__col--brand">
        <div class="verenne-footer__logo">
          <span class="verenne-brand-wordmark">{{ section.settings.brand_name | default: shop.name }}</span>
        </div>
        {%- if section.settings.brand_tagline != blank -%}
          <p class="verenne-footer__tagline">{{ section.settings.brand_tagline | escape }}</p>
        {%- endif -%}

        <!-- Grasse Live Clock Widget -->
        <div class="verenne-footer__clock" aria-label="Grasse Laboratory Time">
          <span class="verenne-footer__clock-dot"></span>
          <span class="verenne-footer__clock-label">Grasse Lab:</span>
          <span class="verenne-footer__clock-time" id="verenne-grasse-time">14:00 CET</span>
        </div>
      </div>

      <!-- Navigation Columns -->
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'link_list' -%}
            <div class="verenne-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h4 class="verenne-footer__heading">{{ block.settings.heading | escape }}</h4>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="verenne-footer__links" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      <a href="{{ link.url }}" class="verenne-footer__link">{{ link.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>

          {%- when 'newsletter' -%}
            <div class="verenne-footer__col verenne-footer__col--newsletter" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h4 class="verenne-footer__heading">{{ block.settings.heading | escape }}</h4>
              {%- endif -%}
              {%- if block.settings.subtext != blank -%}
                <p class="verenne-footer__subtext">{{ block.settings.subtext | escape }}</p>
              {%- endif -%}

              {%- form 'customer', class: 'verenne-footer__newsletter-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="verenne-footer__newsletter-input-wrap">
                  <input
                    type="email"
                    name="contact[email]"
                    class="verenne-footer__input"
                    value="{{ form.email }}"
                    placeholder="{{ block.settings.placeholder | default: 'Your email address' }}"
                    required
                    aria-label="Email subscription"
                  >
                  <button type="submit" class="verenne-footer__submit-btn" aria-label="Subscribe">
                    →
                  </button>
                </div>
                {%- if form.posted_successfully? -%}
                  <p class="verenne-footer__success">Thank you for joining the archival dispatch.</p>
                {%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <!-- Bottom Bar: Legal & Country Selector -->
    <div class="verenne-footer__bottom">
      <div class="verenne-footer__copyright">
        <small>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</small>
        {%- if section.settings.show_policy -%}
          <div class="verenne-footer__policies">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <a href="{{ policy.url }}" class="verenne-footer__policy-link">{{ policy.title }}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <div class="verenne-footer__localization">
          {%- form 'localization' -%}
            <select name="country_code" class="verenne-footer__select" onchange="this.form.submit()">
              {%- for country in localization.available_countries -%}
                <option value="{{ country.iso_code }}" {%- if country.iso_code == localization.country.iso_code %} selected{%- endif %}>
                  {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                </option>
              {%- endfor -%}
            </select>
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

<script>
  (function() {
    function updateGrasseTime() {
      const clockEl = document.getElementById('verenne-grasse-time');
      if (!clockEl) return;
      try {
        const now = new Date();
        const timeStr = now.toLocaleTimeString('en-GB', {
          timeZone: 'Europe/Paris',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: false
        });
        clockEl.textContent = timeStr + ' CET';
      } catch (e) {
        // Fallback silently if timezone not supported
      }
    }
    updateGrasseTime();
    setInterval(updateGrasseTime, 1000);
  })();
</script>

{% schema %}
{
  "name": "Verenne Footer",
  "tag": "footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name override",
      "default": "VERENNE"
    },
    {
      "type": "textarea",
      "id": "brand_tagline",
      "label": "Brand motto / tagline",
      "default": "Haute-Botanique Formulations compounded in Grasse, France. Limited archival editions in violet Miron glass."
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Enable country/region selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "label": "Show store policy links",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Navigation Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "The House"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Archival Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Archival Dispatch"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Receive private allocations and botanical harvest records."
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Input placeholder",
          "default": "atelier@domain.com"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "link_list"
      },
      {
        "type": "newsletter"
      }
    ]
  }
}
{% endschema %}

