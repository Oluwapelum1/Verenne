<div class="verenne-section verenne-circadian-ritual" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; position: relative; overflow: hidden; background-color: #1A130E !important; color: #FAF6EE !important;">
  <div class="verenne-container">
    <div class="verenne-ritual-grid">
      <!-- Left Column: Copy, Tabs & Steps -->
      <div class="verenne-ritual-content">
        <p class="verenne-caption">{{ section.settings.caption | escape }}</p>
        <h2 class="verenne-heading verenne-ritual-title">
          {{ section.settings.heading | escape }}
          <em class="verenne-gold-text" id="verenne-ritual-subtitle-mode">{{ section.settings.dawn_subtitle | escape }}</em>
        </h2>

        <!-- Time of Day Mode Switcher -->
        <div class="verenne-ritual-tabs" role="tablist" aria-label="Ritual Time of Day">
          <button
            type="button"
            role="tab"
            aria-selected="true"
            id="verenne-tab-dawn"
            class="verenne-ritual-tab active"
            onclick="switchVerenneRitual('dawn')"
          >
            <span class="verenne-ritual-tab__icon">☼</span>
            <span>{{ section.settings.dawn_tab_label | default: 'Dawn (AM)' }}</span>
          </button>
          <button
            type="button"
            role="tab"
            aria-selected="false"
            id="verenne-tab-dusk"
            class="verenne-ritual-tab"
            onclick="switchVerenneRitual('dusk')"
          >
            <span class="verenne-ritual-tab__icon">☾</span>
            <span>{{ section.settings.dusk_tab_label | default: 'Dusk (PM)' }}</span>
          </button>
        </div>

        <!-- Dawn Steps List -->
        <ol class="verenne-ritual-steps" id="verenne-steps-dawn">
          {%- for block in section.blocks -%}
            {%- if block.type == 'step_dawn' -%}
              <li class="verenne-ritual-step-item{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                <button type="button" class="verenne-ritual-step-btn" onclick="selectVerenneRitualStep('dawn', {{ forloop.index0 }})">
                  <span class="verenne-step-time">{{ block.settings.time | escape }}</span>
                  <span class="verenne-step-verb">{{ block.settings.verb | escape }}</span>
                  <span class="verenne-step-product">
                    <span class="verenne-step-product-title">{{ block.settings.product_title | escape }}</span>
                    <span class="verenne-step-product-price">{{ block.settings.price | escape }}</span>
                  </span>
                </button>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>

        <!-- Dusk Steps List (Hidden initially) -->
        <ol class="verenne-ritual-steps" id="verenne-steps-dusk" style="display: none;">
          {%- for block in section.blocks -%}
            {%- if block.type == 'step_dusk' -%}
              <li class="verenne-ritual-step-item{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                <button type="button" class="verenne-ritual-step-btn" onclick="selectVerenneRitualStep('dusk', {{ forloop.index0 }})">
                  <span class="verenne-step-time">{{ block.settings.time | escape }}</span>
                  <span class="verenne-step-verb">{{ block.settings.verb | escape }}</span>
                  <span class="verenne-step-product">
                    <span class="verenne-step-product-title">{{ block.settings.product_title | escape }}</span>
                    <span class="verenne-step-product-price">{{ block.settings.price | escape }}</span>
                  </span>
                </button>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>

        <!-- Action CTA -->
        <div class="verenne-ritual-action">
          {%- if section.settings.collection != blank -%}
            <a href="{{ section.settings.collection.url }}" class="verenne-pill-btn verenne-pill-btn--primary">
              {{ section.settings.button_label | default: 'Add Complete Ritual' }} →
            </a>
          {%- else -%}
            <a href="{{ routes.all_products_collection_url }}" class="verenne-pill-btn verenne-pill-btn--primary">
              {{ section.settings.button_label | default: 'Add Complete Ritual' }} →
            </a>
          {%- endif -%}
          <span class="verenne-ritual-subtext">{{ section.settings.action_subtext | default: 'Numbered editions · Insured Grasse delivery' }}</span>
        </div>
      </div>

      <!-- Right Column: Interactive Orbital Dial -->
      <div class="verenne-ritual-dial-wrapper">
        <div class="verenne-dial-face">
          <!-- Orbital rings -->
          <div class="verenne-dial-ring verenne-dial-ring--outer"></div>
          <div class="verenne-dial-ring verenne-dial-ring--inner"></div>
          
          <!-- Center Media / Visual -->
          <div class="verenne-dial-center" id="verenne-dial-center">
            {%- if section.settings.dial_image != blank -%}
              <div class="verenne-dial-img-wrap">
                {{
                  section.settings.dial_image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    class: 'verenne-dial-img',
                    alt: section.settings.heading | escape
                }}
              </div>
            {%- else -%}
              <div class="verenne-dial-img-wrap" style="width: 140px; height: 140px; border-radius: 50%; overflow: hidden; border: 2px solid var(--verenne-gold); margin-bottom: 0.5rem; box-shadow: 0 0 25px rgba(232, 158, 108, 0.35);">
                <img
                  src="{{ 'eclat-sauvage.jpg' | asset_url }}"
                  class="verenne-dial-img"
                  style="width: 100%; height: 100%; object-fit: cover;"
                  alt="Circadian Ritual Formulation — Verenne"
                  loading="lazy"
                  width="140"
                  height="140"
                >
              </div>
              <span class="verenne-dial-crest">VERENNE</span>
              <span class="verenne-dial-status" id="verenne-dial-mode-text">AM RITUAL</span>
              <div class="verenne-dial-dots">
                <span class="dot active"></span>
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function switchVerenneRitual(mode) {
    const isDawn = mode === 'dawn';
    document.getElementById('verenne-tab-dawn').classList.toggle('active', isDawn);
    document.getElementById('verenne-tab-dusk').classList.toggle('active', !isDawn);
    document.getElementById('verenne-tab-dawn').setAttribute('aria-selected', isDawn);
    document.getElementById('verenne-tab-dusk').setAttribute('aria-selected', !isDawn);

    document.getElementById('verenne-steps-dawn').style.display = isDawn ? 'block' : 'none';
    document.getElementById('verenne-steps-dusk').style.display = isDawn ? 'none' : 'block';

    const subtitleEl = document.getElementById('verenne-ritual-subtitle-mode');
    if (subtitleEl) {
      subtitleEl.textContent = isDawn ? '{{ section.settings.dawn_subtitle | escape }}' : '{{ section.settings.dusk_subtitle | escape }}';
    }

    const modeTextEl = document.getElementById('verenne-dial-mode-text');
    if (modeTextEl) {
      modeTextEl.textContent = isDawn ? 'AM RITUAL' : 'PM RITUAL';
    }
  }

  function selectVerenneRitualStep(mode, index) {
    const list = document.getElementById(mode === 'dawn' ? 'verenne-steps-dawn' : 'verenne-steps-dusk');
    if (!list) return;
    const items = list.querySelectorAll('.verenne-ritual-step-item');
    items.forEach((item, i) => {
      item.classList.toggle('active', i === index);
    });
    
    const dots = document.querySelectorAll('.verenne-dial-dots .dot');
    dots.forEach((dot, i) => {
      dot.classList.toggle('active', i === index);
    });
  }
</script>

