{%- comment -%}
  Verenne Circadian Ritual
  1:1 port of src/components/Ritual.jsx from https://oluwapelum1.github.io/Verenne/
  - Dawn / Dusk toggle with sliding pill; each mode has its own four products
  - 60-tick dial that turns 180° at dusk, four orbiting step nodes
  - Centre photograph of the active step with exit/enter transition
  - Single-click routine addition to bag with live total
{%- endcomment -%}

<section id="ritual" class="vr-ritual tone-dark" aria-labelledby="ritual-title" data-mode="dawn">
  <div class="vr-ritual__glow vr-ritual__glow--dawn" aria-hidden="true"></div>
  <div class="vr-ritual__glow vr-ritual__glow--dusk" aria-hidden="true"></div>

  <div class="vr-ritual__grid">
    <!-- Copy + steps -->
    <div class="vr-ritual__copy">
      <p class="vr-ritual__label">The ritual</p>
      <h2 id="ritual-title" class="vr-ritual__title">
        Four steps. <br>
        <em class="vr-ritual__accent" data-ritual-subtitle>Every morning.</em>
      </h2>

      <div class="vr-ritual__tabs" role="tablist" aria-label="Time of day">
        <span class="vr-ritual__pill" aria-hidden="true"></span>
        <button type="button" role="tab" aria-selected="true" class="vr-ritual__tab is-active" data-ritual-mode="dawn">
          <svg class="vr-ritual__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
          </svg>
          <span class="vr-ritual__tab-text">Dawn</span>
        </button>
        <button type="button" role="tab" aria-selected="false" class="vr-ritual__tab" data-ritual-mode="dusk">
          <svg class="vr-ritual__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/>
          </svg>
          <span class="vr-ritual__tab-text">Dusk</span>
        </button>
      </div>

      <ol class="vr-ritual__steps" data-ritual-steps></ol>

      <div class="vr-ritual__actions">
        <button type="button" class="vr-ritual__add" data-ritual-add>
          <span class="vr-ritual__add-fill" aria-hidden="true"></span>
          <span class="vr-ritual__add-text" data-ritual-add-text>Add the dawn ritual — $336</span>
        </button>
        <span class="vr-ritual__label">Ships together · free delivery</span>
      </div>
    </div>

    <!-- Dial -->
    <div class="vr-ritual__dial">
      <div class="vr-ritual__face" data-ritual-face>
        <svg viewBox="0 0 400 400" aria-hidden="true">
          <circle cx="200" cy="200" r="196" fill="none" stroke="rgba(237,231,220,0.12)" />
          <circle cx="200" cy="200" r="150" fill="none" stroke="rgba(237,231,220,0.08)" stroke-dasharray="2 6" />
          {%- for i in (0..59) -%}
            {%- assign deg = i | times: 6 -%}
            {%- assign tick = i | modulo: 5 -%}
            <line x1="200" y1="6" x2="200" y2="{% if tick == 0 %}18{% else %}12{% endif %}" stroke="rgba(237,231,220,0.25)" transform="rotate({{ deg }} 200 200)" />
          {%- endfor -%}
          <circle cx="200" cy="4" r="5" fill="#E2B26A" />
          <circle cx="200" cy="396" r="5" fill="#7B5CC4" />
        </svg>
      </div>

      <!-- Steps around the dial (not rotated, so labels stay legible) -->
      <div data-ritual-nodes></div>

      <!-- Centre -->
      <div class="vr-ritual__center">
        <div class="vr-ritual__frame is-in" data-ritual-frame>
          <img
            data-ritual-center
            src="{{ 'argile-purifiante-600.webp' | asset_url }}"
            alt="N°05 Argile Purifiante"
            width="600"
            height="750"
            decoding="async"
          >
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #ritual.vr-ritual {
    --r-bg: #1A130E;
    --r-text-primary: #EFE7DA;
    --r-text-secondary: #C2B5A4;
    --r-text-muted: #A39585;
    --r-border-subtle: rgba(239, 231, 218, 0.12);
    --r-border-strong: rgba(239, 231, 218, 0.28);
    --r-accent: #E0935F;
    --r-accent-ink: #1A130E;
    --r-ease: cubic-bezier(0.16, 1, 0.3, 1);
    --r-serif: 'Bodoni Moda', 'Times New Roman', serif;
    --r-sans: 'Hanken Grotesk', system-ui, sans-serif;

    position: relative;
    overflow: hidden;
    padding: 6rem 1.25rem;
    background-color: var(--r-bg) !important;
    color: var(--r-text-primary) !important;
    font-family: var(--r-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }
  @media (min-width: 640px) {
    #ritual.vr-ritual { padding: 8rem 2.5rem; }
  }

  #ritual .vr-ritual__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: opacity 1.4s ease;
  }
  #ritual .vr-ritual__glow--dawn { background: radial-gradient(60% 60% at 70% 50%, rgba(224, 147, 95, 0.14), transparent 70%); }
  #ritual .vr-ritual__glow--dusk { background: radial-gradient(60% 60% at 70% 50%, rgba(165, 82, 42, 0.2), transparent 70%); opacity: 0; }
  #ritual[data-mode='dusk'] .vr-ritual__glow--dawn { opacity: 0; }
  #ritual[data-mode='dusk'] .vr-ritual__glow--dusk { opacity: 1; }

  #ritual .vr-ritual__grid {
    position: relative;
    max-width: 1600px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 4rem;
  }
  @media (min-width: 1024px) {
    #ritual .vr-ritual__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    #ritual .vr-ritual__copy { grid-column: span 5 / span 5; }
    #ritual .vr-ritual__dial { grid-column: span 7 / span 7; }
  }

  #ritual .vr-ritual__label {
    margin: 0;
    font-family: var(--r-sans);
    font-size: 13px;
    font-weight: 400;
    font-style: normal;
    letter-spacing: 0;
    text-transform: none;
    color: var(--r-text-secondary) !important;
  }

  #ritual .vr-ritual__title {
    margin: 1rem 0 0;
    font-family: var(--r-serif);
    font-size: clamp(2.6rem, 5vw, 4.5rem);
    font-weight: 400;
    font-style: normal;
    font-optical-sizing: auto;
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--r-text-primary) !important;
  }
  #ritual .vr-ritual__accent {
    font-family: var(--r-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--r-accent) !important;
  }

  /* Dawn / Dusk */
  #ritual .vr-ritual__tabs {
    position: relative;
    display: inline-flex;
    margin-top: 2rem;
    padding: 0.25rem;
    border: 1px solid var(--r-border-subtle);
    border-radius: 9999px;
  }
  #ritual .vr-ritual__pill {
    position: absolute;
    top: 0.25rem;
    left: 0;
    height: calc(100% - 0.5rem);
    width: 0;
    border-radius: 9999px;
    background: var(--r-text-primary);
    transition: transform 0.55s var(--r-ease), width 0.55s var(--r-ease);
  }
  #ritual .vr-ritual__tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.5rem 1.25rem;
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
    cursor: pointer;
    font-family: var(--r-sans);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.25rem;
    color: var(--r-text-secondary);
    transition: color 0.3s ease;
  }
  #ritual .vr-ritual__tab.is-active { color: var(--r-accent-ink); }
  #ritual .vr-ritual__tab-text { position: relative; font: inherit; color: inherit; }
  #ritual .vr-ritual__icon { position: relative; width: 14px; height: 14px; flex: none; }

  /* Steps */
  #ritual .vr-ritual__steps {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    border-top: 1px solid var(--r-border-subtle);
  }
  #ritual .vr-ritual__step { border-bottom: 1px solid var(--r-border-subtle); }
  #ritual .vr-ritual__step-btn {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 1.25rem;
    margin: 0;
    padding: 1rem 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
    color: inherit;
  }
  #ritual .vr-ritual__time {
    font-family: var(--r-sans);
    font-size: 11px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    color: var(--r-text-muted) !important;
  }
  #ritual .vr-ritual__verb {
    display: inline-block;
    font-family: var(--r-serif);
    font-size: 1.875rem;
    line-height: 2.25rem;
    font-weight: 400;
    font-style: normal;
    letter-spacing: -0.01em;
    color: var(--r-text-secondary) !important;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  #ritual .vr-ritual__step.is-active .vr-ritual__verb {
    transform: translateX(0.25rem);
    font-style: italic;
    color: var(--r-text-primary) !important;
  }
  #ritual .vr-ritual__product {
    margin-left: auto;
    text-align: right;
    font-family: var(--r-sans);
    font-size: 13px;
    font-weight: 400;
    color: var(--r-text-secondary) !important;
  }
  #ritual .vr-ritual__price {
    display: block;
    font-family: var(--r-sans);
    font-size: 11px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    color: var(--r-text-muted) !important;
  }

  /* Add the ritual */
  #ritual .vr-ritual__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }
  #ritual .vr-ritual__add {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    overflow: hidden;
    margin: 0;
    padding: 1rem 1.75rem;
    border: 0;
    border-radius: 0;
    background: var(--r-text-primary);
    cursor: pointer;
    color: var(--r-accent-ink);
    transition: color 0.5s ease;
  }
  #ritual .vr-ritual__add-fill {
    position: absolute;
    inset: 0;
    background: var(--r-accent);
    transform: translateY(101%);
    transition: transform 0.5s var(--r-ease);
  }
  #ritual .vr-ritual__add:hover .vr-ritual__add-fill,
  #ritual .vr-ritual__add:focus-visible .vr-ritual__add-fill { transform: translateY(0); }
  #ritual .vr-ritual__add-text {
    position: relative;
    z-index: 1;
    font-family: var(--r-sans);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--r-accent-ink) !important;
  }

  #ritual .vr-ritual__tab:focus-visible,
  #ritual .vr-ritual__step-btn:focus-visible,
  #ritual .vr-ritual__node:focus-visible,
  #ritual .vr-ritual__add:focus-visible {
    outline: 1px solid var(--r-accent);
    outline-offset: 3px;
  }

  /* Dial */
  #ritual .vr-ritual__dial {
    position: relative;
    width: 100%;
    max-width: 600px;
    aspect-ratio: 1 / 1;
    margin: 0 auto;
  }
  #ritual .vr-ritual__face {
    position: absolute;
    inset: 0;
    transition: transform 1.6s cubic-bezier(0.83, 0, 0.17, 1);
  }
  #ritual[data-mode='dusk'] .vr-ritual__face { transform: rotate(180deg); }
  #ritual .vr-ritual__face svg { position: absolute; inset: 0; width: 100%; height: 100%; }

  #ritual .vr-ritual__node {
    position: absolute;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
    transition: transform 0.6s var(--r-ease), opacity 0.6s var(--r-ease);
  }
  #ritual .vr-ritual__node.is-active { transform: translate(-50%, -50%) scale(1.15); }
  #ritual .vr-ritual__node.is-entering { opacity: 0; transform: translate(-50%, -50%) scale(0.6); transition: none; }
  #ritual .vr-ritual__thumb {
    display: block;
    width: 3.5rem;
    height: 3.5rem;
    overflow: hidden;
    border-radius: 9999px;
    border: 2px solid var(--r-border-subtle);
    transition: border-color 0.15s ease;
  }
  @media (min-width: 640px) {
    #ritual .vr-ritual__thumb { width: 4rem; height: 4rem; }
  }
  #ritual .vr-ritual__node.is-active .vr-ritual__thumb { border-color: var(--r-text-primary); }
  #ritual .vr-ritual__thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
  #ritual .vr-ritual__num { display: block; margin-top: 0.5rem; text-align: center; }

  #ritual .vr-ritual__center {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 40%;
    height: 52%;
    transform: translate(-50%, -50%);
  }
  #ritual .vr-ritual__frame {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--r-border-strong);
    border-radius: 0;
    transition: opacity 0.55s var(--r-ease), transform 0.55s var(--r-ease);
  }
  #ritual .vr-ritual__frame.is-in { opacity: 1; transform: translateY(0) scale(1); }
  #ritual .vr-ritual__frame.is-out { opacity: 0; transform: translateY(-16px) scale(0.96); }
  #ritual .vr-ritual__frame.is-pre { opacity: 0; transform: translateY(16px) scale(0.96); transition: none; }
  #ritual .vr-ritual__frame img { display: block; width: 100%; height: 100%; object-fit: cover; }

  @media (prefers-reduced-motion: reduce) {
    #ritual *, #ritual *::before, #ritual *::after { transition-duration: 0.01ms !important; transition-delay: 0s !important; }
  }
</style>

<script>
  (function () {
    const section = document.getElementById('ritual');
    if (!section || section.dataset.ready) return;
    section.dataset.ready = 'true';

    const PRODUCTS = {
      'argile-purifiante': { name: 'Argile Purifiante', fullName: 'N°05 Argile Purifiante', price: 58, img: "{{ 'argile-purifiante-600.webp' | asset_url }}", thumb: "{{ 'argile-purifiante-320.webp' | asset_url }}" },
      'brume-botanique': { name: 'Brume Botanique', fullName: 'N°03 Brume Botanique', price: 68, img: "{{ 'brume-botanique-600.webp' | asset_url }}", thumb: "{{ 'brume-botanique-320.webp' | asset_url }}" },
      'eclat-sauvage': { name: 'Éclat Sauvage', fullName: 'N°01 Éclat Sauvage', price: 118, img: "{{ 'eclat-sauvage-600.webp' | asset_url }}", thumb: "{{ 'eclat-sauvage-320.webp' | asset_url }}" },
      'creme-radieuse': { name: 'Crème Radieuse', fullName: 'N°06 Crème Radieuse', price: 92, img: "{{ 'creme-radieuse-600.webp' | asset_url }}", thumb: "{{ 'creme-radieuse-320.webp' | asset_url }}" },
      'huile-soyeuse': { name: 'Huile Soyeuse Purifiante', fullName: 'N°09 Huile Soyeuse Purifiante', price: 72, img: "{{ 'huile-soyeuse-600.webp' | asset_url }}", thumb: "{{ 'huile-soyeuse-320.webp' | asset_url }}" },
      'essence-fleurie': { name: 'Essence Florale Cellulaire', fullName: 'N°12 Essence Florale Cellulaire', price: 78, img: "{{ 'essence-fleurie-600.webp' | asset_url }}", thumb: "{{ 'essence-fleurie-320.webp' | asset_url }}" },
      'seve-doree': { name: 'Sève Dorée', fullName: 'N°04 Sève Dorée', price: 135, img: "{{ 'seve-doree-600.webp' | asset_url }}", thumb: "{{ 'seve-doree-320.webp' | asset_url }}" },
      'baume-resineux': { name: 'Baume Résineux', fullName: 'N°02 Baume Résineux', price: 94, img: "{{ 'baume-resineux-600.webp' | asset_url }}", thumb: "{{ 'baume-resineux-320.webp' | asset_url }}" }
    };

    const RITUAL = {
      dawn: [
        { id: 'argile-purifiante', verb: 'Cleanse', time: '07:00' },
        { id: 'brume-botanique', verb: 'Mist', time: '07:02' },
        { id: 'eclat-sauvage', verb: 'Illuminate', time: '07:03' },
        { id: 'creme-radieuse', verb: 'Veil', time: '07:05' }
      ],
      dusk: [
        { id: 'huile-soyeuse', verb: 'Dissolve', time: '22:00' },
        { id: 'essence-fleurie', verb: 'Quench', time: '22:02' },
        { id: 'seve-doree', verb: 'Renew', time: '22:04' },
        { id: 'baume-resineux', verb: 'Seal', time: '22:06' }
      ]
    };

    const stepsEl = section.querySelector('[data-ritual-steps]');
    const nodesEl = section.querySelector('[data-ritual-nodes]');
    const frame = section.querySelector('[data-ritual-frame]');
    const centerImg = section.querySelector('[data-ritual-center]');
    const subtitle = section.querySelector('[data-ritual-subtitle]');
    const addBtn = section.querySelector('[data-ritual-add]');
    const addText = section.querySelector('[data-ritual-add-text]');
    const tabs = Array.from(section.querySelectorAll('[data-ritual-mode]'));
    const pill = section.querySelector('.vr-ritual__pill');

    let mode = 'dawn';
    let step = 0;
    let shownKey = 'dawn-argile-purifiante';
    let swapTimer = null;

    // Warm the cache so dusk and every step swap instantly
    Object.values(PRODUCTS).forEach((p) => {
      new Image().src = p.img;
      new Image().src = p.thumb;
    });

    function movePill(animate) {
      const tab = tabs.find((t) => t.dataset.ritualMode === mode);
      if (!tab || !pill) return;
      if (!animate) pill.style.transition = 'none';
      pill.style.width = tab.offsetWidth + 'px';
      pill.style.transform = 'translateX(' + tab.offsetLeft + 'px)';
      if (!animate) {
        pill.offsetWidth;
        pill.style.transition = '';
      }
    }

    function renderSteps() {
      stepsEl.innerHTML = '';
      RITUAL[mode].forEach((s, i) => {
        const p = PRODUCTS[s.id];
        const li = document.createElement('li');
        li.className = 'vr-ritual__step' + (i === step ? ' is-active' : '');
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'vr-ritual__step-btn';
        btn.innerHTML =
          '<span class="vr-ritual__time"></span><span class="vr-ritual__verb"></span>' +
          '<span class="vr-ritual__product"><span class="vr-ritual__name"></span><span class="vr-ritual__price"></span></span>';
        btn.querySelector('.vr-ritual__time').textContent = s.time;
        btn.querySelector('.vr-ritual__verb').textContent = s.verb;
        btn.querySelector('.vr-ritual__name').textContent = p.name;
        btn.querySelector('.vr-ritual__price').textContent = '$' + p.price;
        btn.addEventListener('click', () => setStep(i));
        btn.addEventListener('mouseenter', () => setStep(i));
        li.appendChild(btn);
        stepsEl.appendChild(li);
      });
    }

    function renderNodes() {
      nodesEl.innerHTML = '';
      RITUAL[mode].forEach((s, i) => {
        const p = PRODUCTS[s.id];
        const angle = (-90 + 45 + i * 90) * (Math.PI / 180);
        const r = 41;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'vr-ritual__node is-entering' + (i === step ? ' is-active' : '');
        btn.style.left = 50 + Math.cos(angle) * r + '%';
        btn.style.top = 50 + Math.sin(angle) * r + '%';
        btn.setAttribute('aria-label', s.verb + ': ' + p.fullName);
        btn.innerHTML = '<span class="vr-ritual__thumb"><img alt="" loading="lazy" width="320" height="320"></span><span class="vr-ritual__label vr-ritual__num"></span>';
        const img = btn.querySelector('img');
        img.src = p.thumb;
        img.alt = p.name;
        btn.querySelector('.vr-ritual__num').textContent = String(i + 1).padStart(2, '0');
        btn.addEventListener('click', () => setStep(i));
        nodesEl.appendChild(btn);

        // Staggered entrance, then normal (undelayed) transitions for the active scale
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            btn.style.transitionDelay = 0.5 + i * 0.08 + 's';
            btn.classList.remove('is-entering');
            setTimeout(() => { btn.style.transitionDelay = ''; }, (1.1 + i * 0.08) * 1000);
          });
        });
      });
    }

    function syncActive() {
      stepsEl.querySelectorAll('.vr-ritual__step').forEach((el, i) => el.classList.toggle('is-active', i === step));
      nodesEl.querySelectorAll('.vr-ritual__node').forEach((el, i) => el.classList.toggle('is-active', i === step));
    }

    // AnimatePresence mode="wait": old photo exits up, then the new one rises in
    function updateCenter() {
      const s = RITUAL[mode][step];
      const key = mode + '-' + s.id;
      if (key === shownKey) return;
      shownKey = key;
      clearTimeout(swapTimer);
      frame.classList.remove('is-in', 'is-pre');
      frame.classList.add('is-out');
      swapTimer = setTimeout(() => {
        const cur = RITUAL[mode][step];
        const p = PRODUCTS[cur.id];
        centerImg.src = p.img;
        centerImg.alt = p.fullName;
        const show = () => {
          frame.classList.remove('is-out');
          frame.classList.add('is-pre');
          frame.offsetWidth;
          frame.classList.remove('is-pre');
          frame.classList.add('is-in');
        };
        (centerImg.decode ? centerImg.decode() : Promise.resolve()).then(show, show);
      }, 550);
    }

    function setStep(i) {
      if (i === step) return;
      step = i;
      syncActive();
      updateCenter();
    }

    function updateTotal() {
      const total = RITUAL[mode].reduce((sum, s) => sum + PRODUCTS[s.id].price, 0);
      addText.textContent = 'Add the ' + mode + ' ritual — $' + total;
    }

    function switchMode(m) {
      if (m === mode) return;
      mode = m;
      step = 0;
      section.dataset.mode = m;
      tabs.forEach((t) => {
        const on = t.dataset.ritualMode === m;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      movePill(true);
      subtitle.textContent = m === 'dusk' ? 'Twice at night.' : 'Every morning.';
      updateTotal();
      renderSteps();
      renderNodes();
      updateCenter();
    }

    tabs.forEach((t) => t.addEventListener('click', () => switchMode(t.dataset.ritualMode)));

    addBtn.addEventListener('click', () => {
      RITUAL[mode].forEach((s, i) => {
        const p = PRODUCTS[s.id];
        setTimeout(() => {
          if (typeof window.addVerenneCartItem === 'function') {
            window.addVerenneCartItem(p.fullName, '$' + p.price, 'Standard', p.img);
          }
        }, i * 120);
      });
    });

    // Keep the old global API working for anything that still calls it
    window.switchRitualMode = switchMode;

    renderSteps();
    renderNodes();
    updateTotal();
    movePill(false);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => movePill(false));
    window.addEventListener('resize', () => movePill(false));
  })();
</script>

