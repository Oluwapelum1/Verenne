{%- comment -%}
  Verenne Circadian Ritual
  1:1 Replica of Ritual.jsx from https://oluwapelum1.github.io/Verenne/
  Includes:
  - Dawn / Dusk toggle with chronobiological routine switching
  - Interactive 60-tick Orbital Dial with rotating face and 4 orbiting nodes
  - Central dynamic formulation photograph matching the active step
  - Single-click routine addition to bag with total calculation
{%- endcomment -%}

<section id="ritual" class="verenne-ritual-section" aria-labelledby="ritual-title">
  <div class="verenne-ritual-container">
    
    <!-- Left Column: Copy & Steps -->
    <div class="verenne-ritual-col-left">
      <p class="verenne-ritual-eyebrow">The ritual</p>
      <h2 id="ritual-title" class="verenne-ritual-headline">
        Four steps.<br>
        <em id="ritual-mode-subtitle" class="verenne-ritual-accent-text">Every morning.</em>
      </h2>

      <!-- Dawn / Dusk Tab Switcher -->
      <div class="verenne-ritual-pill-tabs" role="tablist" aria-label="Time of day">
        <button
          type="button"
          id="btn-ritual-dawn"
          class="verenne-mode-btn active"
          role="tab"
          aria-selected="true"
          onclick="switchRitualMode('dawn')"
        >
          <span class="verenne-mode-icon">☼</span>
          <span>Dawn</span>
        </button>
        <button
          type="button"
          id="btn-ritual-dusk"
          class="verenne-mode-btn"
          role="tab"
          aria-selected="false"
          onclick="switchRitualMode('dusk')"
        >
          <span class="verenne-mode-icon">☾</span>
          <span>Dusk</span>
        </button>
      </div>

      <!-- Steps List -->
      <ol class="verenne-steps-list" id="ritual-steps-container">
        <!-- Rendered dynamically via JavaScript -->
      </ol>

      <!-- Bottom Routine Buy Action -->
      <div class="verenne-ritual-footer-action">
        <button type="button" class="verenne-btn-add-routine" id="ritual-add-all-btn" onclick="addAllRitualToBag()">
          Add the dawn ritual — $336
        </button>
        <span class="verenne-ritual-ships-label">Ships together · free delivery</span>
      </div>
    </div>

    <!-- Right Column: The 60-Tick Orbital Clock Dial -->
    <div class="verenne-ritual-col-right">
      <div class="verenne-dial-wrap">
        
        <!-- Rotating SVG Clock Face (60 ticks) -->
        <div class="verenne-dial-svg-plate" id="verenne-dial-plate">
          <svg viewBox="0 0 400 400" class="verenne-dial-svg" aria-hidden="true">
            <circle cx="200" cy="200" r="196" fill="none" stroke="rgba(237,231,220,0.12)" />
            <circle cx="200" cy="200" r="150" fill="none" stroke="rgba(237,231,220,0.08)" stroke-dasharray="2 6" />
            <!-- 60 ticks -->
            {%- for i in (0..59) -%}
              {%- assign deg = i | times: 6 -%}
              {%- assign is_major = i | modulo: 5 -%}
              {%- if is_major == 0 -%}
                <line x1="200" y1="6" x2="200" y2="18" stroke="rgba(237,231,220,0.35)" transform="rotate({{ deg }} 200 200)" />
              {%- else -%}
                <line x1="200" y1="6" x2="200" y2="12" stroke="rgba(237,231,220,0.18)" transform="rotate({{ deg }} 200 200)" />
              {%- endif -%}
            {%- endfor -%}
            <!-- Gold indicator at 12 o'clock, violet indicator at 6 o'clock -->
            <circle cx="200" cy="5" r="5" fill="#E2B26A" />
            <circle cx="200" cy="395" r="5" fill="#7B5CC4" />
          </svg>
        </div>

        <!-- 4 Orbiting Step Nodes (01, 02, 03, 04) -->
        <div class="verenne-orbit-nodes" id="ritual-orbit-nodes">
          <!-- Rendered dynamically via JavaScript -->
        </div>

        <!-- Central Square Photograph of the Active Formulation -->
        <div class="verenne-dial-center-box">
          <img id="ritual-center-img" src="{{ 'argile-purifiante.jpg' | asset_url }}" alt="Active ritual formulation" class="verenne-dial-center-photo" width="400" height="400">
        </div>

      </div>
    </div>

  </div>
</section>

<script>
  const RITUAL_DATA = {
    dawn: {
      subtitle: 'Every morning.',
      total: 336,
      steps: [
        {
          id: 'argile-purifiante',
          time: '07:00',
          verb: 'Cleanse',
          name: 'Argile Purifiante',
          price: 58,
          image: "{{ 'argile-purifiante.jpg' | asset_url }}",
          thumb: "{{ 'argile-purifiante.jpg' | asset_url }}"
        },
        {
          id: 'brume-botanique',
          time: '07:02',
          verb: 'Mist',
          name: 'Brume Botanique',
          price: 68,
          image: "{{ 'brume-botanique.jpg' | asset_url }}",
          thumb: "{{ 'brume-botanique.jpg' | asset_url }}"
        },
        {
          id: 'eclat-sauvage',
          time: '07:03',
          verb: 'Illuminate',
          name: 'Éclat Sauvage',
          price: 118,
          image: "{{ 'eclat-sauvage.jpg' | asset_url }}",
          thumb: "{{ 'eclat-sauvage.jpg' | asset_url }}"
        },
        {
          id: 'creme-radieuse',
          time: '07:05',
          verb: 'Veil',
          name: 'Crème Radieuse',
          price: 92,
          image: "{{ 'creme-radieuse.jpg' | asset_url }}",
          thumb: "{{ 'creme-radieuse.jpg' | asset_url }}"
        }
      ]
    },
    dusk: {
      subtitle: 'Twice at night.',
      total: 355,
      steps: [
        {
          id: 'argile-purifiante',
          time: '22:00',
          verb: 'Dissolve',
          name: 'Argile Purifiante',
          price: 58,
          image: "{{ 'argile-purifiante.jpg' | asset_url }}",
          thumb: "{{ 'argile-purifiante.jpg' | asset_url }}"
        },
        {
          id: 'brume-botanique',
          time: '22:02',
          verb: 'Quench',
          name: 'Brume Botanique',
          price: 68,
          image: "{{ 'brume-botanique.jpg' | asset_url }}",
          thumb: "{{ 'brume-botanique.jpg' | asset_url }}"
        },
        {
          id: 'seve-doree',
          time: '22:04',
          verb: 'Renew',
          name: 'Sève Dorée',
          price: 135,
          image: "{{ 'seve-doree.jpg' | asset_url }}",
          thumb: "{{ 'seve-doree.jpg' | asset_url }}"
        },
        {
          id: 'baume-resineux',
          time: '22:06',
          verb: 'Seal',
          name: 'Baume Résineux',
          price: 94,
          image: "{{ 'baume-resineux.jpg' | asset_url }}",
          thumb: "{{ 'baume-resineux.jpg' | asset_url }}"
        }
      ]
    }
  };

  let currentRitualMode = 'dawn';
  let currentRitualStep = 0;

  function switchRitualMode(mode) {
    currentRitualMode = mode;
    currentRitualStep = 0;

    const isDawn = mode === 'dawn';
    document.getElementById('btn-ritual-dawn').classList.toggle('active', isDawn);
    document.getElementById('btn-ritual-dusk').classList.toggle('active', !isDawn);
    document.getElementById('btn-ritual-dawn').setAttribute('aria-selected', isDawn);
    document.getElementById('btn-ritual-dusk').setAttribute('aria-selected', !isDawn);

    const plate = document.getElementById('verenne-dial-plate');
    if (plate) {
      plate.style.transform = isDawn ? 'rotate(0deg)' : 'rotate(180deg)';
    }

    const data = RITUAL_DATA[mode];
    document.getElementById('ritual-mode-subtitle').textContent = data.subtitle;
    document.getElementById('ritual-add-all-btn').textContent = 'Add the ' + mode + ' ritual — $' + data.total;

    renderRitualSteps();
    renderOrbitNodes();
    updateRitualCenterPhoto();
  }

  function setRitualStep(idx) {
    currentRitualStep = idx;
    const items = document.querySelectorAll('.verenne-ritual-row');
    items.forEach((item, i) => {
      item.classList.toggle('active', i === idx);
    });

    const nodes = document.querySelectorAll('.verenne-orbit-node');
    nodes.forEach((node, i) => {
      node.classList.toggle('active', i === idx);
    });

    updateRitualCenterPhoto();
  }

  function updateRitualCenterPhoto() {
    const data = RITUAL_DATA[currentRitualMode];
    const s = data.steps[currentRitualStep];
    const img = document.getElementById('ritual-center-img');
    if (img && s) {
      img.src = s.image;
      img.alt = s.verb + ' — ' + s.name;
    }
  }

  function renderRitualSteps() {
    const data = RITUAL_DATA[currentRitualMode];
    const container = document.getElementById('ritual-steps-container');
    if (!container) return;
    container.innerHTML = '';

    data.steps.forEach((s, idx) => {
      const li = document.createElement('li');
      li.className = 'verenne-ritual-row' + (idx === currentRitualStep ? ' active' : '');
      li.onclick = () => setRitualStep(idx);
      li.onmouseenter = () => setRitualStep(idx);

      li.innerHTML = \`
        <span class="verenne-row-time">\${s.time}</span>
        <span class="verenne-row-verb">\${s.verb}</span>
        <span class="verenne-row-product">
          <span class="verenne-product-name">\${s.name}</span>
          <span class="verenne-product-price">$\${s.price}</span>
        </span>
      \`;
      container.appendChild(li);
    });
  }

  function renderOrbitNodes() {
    const data = RITUAL_DATA[currentRitualMode];
    const container = document.getElementById('ritual-orbit-nodes');
    if (!container) return;
    container.innerHTML = '';

    // Positions on circle face (45deg, 135deg, 225deg, 315deg)
    // Angles in radians: -45, 45, 135, 225
    const angles = [45, 135, 225, 315];
    const r = 41; // radius percentage

    data.steps.forEach((s, idx) => {
      const angleRad = (angles[idx] - 90) * (Math.PI / 180);
      const leftPct = 50 + Math.cos(angleRad) * r;
      const topPct = 50 + Math.sin(angleRad) * r;

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'verenne-orbit-node' + (idx === currentRitualStep ? ' active' : '');
      btn.style.left = leftPct + '%';
      btn.style.top = topPct + '%';
      btn.setAttribute('aria-label', s.verb + ': ' + s.name);
      btn.onclick = () => setRitualStep(idx);

      const numStr = String(idx + 1).padStart(2, '0');
      btn.innerHTML = \`
        <span class="verenne-node-thumb-wrap">
          <img src="\${s.thumb}" alt="\${s.name}" class="verenne-node-thumb" loading="lazy" />
        </span>
        <span class="verenne-node-num">\${numStr}</span>
      \`;
      container.appendChild(btn);
    });
  }

  function addAllRitualToBag() {
    const data = RITUAL_DATA[currentRitualMode];
    data.steps.forEach((s, idx) => {
      setTimeout(() => {
        postVerenneItemToCart('N°' + (idx + 1) + ' ' + s.name, '$' + s.price, 'Standard', 1);
      }, idx * 120);
    });
  }

  // Initialize on Load
  document.addEventListener('DOMContentLoaded', () => {
    renderRitualSteps();
    renderOrbitNodes();
    updateRitualCenterPhoto();
  });
</script>

{% schema %}
{
  "name": "Verenne Ritual",
  "class": "section-verenne-ritual",
  "settings": [],
  "presets": [
    {
      "name": "Verenne Ritual"
    }
  ]
}
{% endschema %}
