{%- comment -%}
  Verenne Circadian Ritual
  1:1 Replica of Ritual.jsx from https://oluwapelum1.github.io/Verenne/
  Includes:
  - Dawn / Dusk toggle with chronobiological routine switching
  - Interactive 60-tick Orbital Dial with rotating face and 4 orbiting nodes
  - Central dynamic formulation photograph matching the active step
  - Single-click routine addition to bag with total calculation
{%- endcomment -%}

<section id="ritual" class="verenne-ritual-section tone-dark" aria-labelledby="ritual-title" style="background-color: #1A130E !important; color: #FAF6EE !important;">
  <div class="verenne-ritual-container">
    
    <!-- Left Column: Copy & Steps -->
    <div class="verenne-ritual-col-left">
      <p class="verenne-ritual-eyebrow">The ritual</p>
      <h2 id="ritual-title" class="verenne-ritual-headline">
        Four steps.<br>
        <em id="ritual-mode-subtitle" class="verenne-ritual-accent-text">Every morning.</em>
      </h2>

      <!-- Dawn / Dusk Tab Switcher -->
      <div class="verenne-ritual-pill-tabs" role="tablist" aria-label="Time of day">
        <button
          type="button"
          id="btn-ritual-dawn"
          class="verenne-mode-btn active"
          role="tab"
          aria-selected="true"
          onclick="switchRitualMode('dawn')"
        >
          <span class="verenne-mode-icon">☼</span>
          <span>Dawn</span>
        </button>
        <button
          type="button"
          id="btn-ritual-dusk"
          class="verenne-mode-btn"
          role="tab"
          aria-selected="false"
          onclick="switchRitualMode('dusk')"
        >
          <span class="verenne-mode-icon">☾</span>
          <span>Dusk</span>
        </button>
      </div>

      <!-- Steps List -->
      <ol class="verenne-steps-list" id="ritual-steps-container">
        <!-- Rendered dynamically via JavaScript -->
      </ol>

      <!-- Bottom Routine Buy Action -->
      <div class="verenne-ritual-footer-action">
        <button type="button" class="verenne-btn-add-routine" id="ritual-add-all-btn" onclick="addAllRitualToBag()">
          Add the dawn ritual — $336
        </button>
        <span class="verenne-ritual-ships-label">Ships together · free delivery</span>
      </div>
    </div>

    <!-- Right Column: The 60-Tick Orbital Clock Dial -->
    <div class="verenne-ritual-col-right">
      <div class="verenne-dial-wrap">
        
        <!-- Rotating SVG Clock Face (60 ticks) -->
        <div class="verenne-dial-svg-plate" id="verenne-dial-plate">
          <svg viewBox="0 0 400 400" class="verenne-dial-svg" aria-hidden="true">
            <circle cx="200" cy="200" r="196" fill="none" stroke="rgba(237,231,220,0.12)" />
            <circle cx="200" cy="200" r="150" fill="none" stroke="rgba(237,231,220,0.08)" stroke-dasharray="2 6" />
            <!-- 60 ticks -->
            {%- for i in (0..59) -%}
              {%- assign deg = i | times: 6 -%}
              {%- assign is_major = i | modulo: 5 -%}
              {%- if is_major == 0 -%}
                <line x1="200" y1="6" x2="200" y2="18" stroke="rgba(237,231,220,0.35)" transform="rotate({{ deg }} 200 200)" />
              {%- else -%}
                <line x1="200" y1="6" x2="200" y2="12" stroke="rgba(237,231,220,0.18)" transform="rotate({{ deg }} 200 200)" />
              {%- endif -%}
            {%- endfor -%}
            <!-- Gold indicator at 12 o'clock, violet indicator at 6 o'clock -->
            <circle cx="200" cy="5" r="5" fill="#E2B26A" />
            <circle cx="200" cy="395" r="5" fill="#7B5CC4" />
          </svg>
        </div>

        <!-- 4 Orbiting Step Nodes (01, 02, 03, 04) -->
        <div class="verenne-orbit-nodes" id="ritual-orbit-nodes">
          <!-- Rendered dynamically via JavaScript -->
        </div>

        <!-- Central Square Photograph of the Active Formulation -->
        <div class="verenne-dial-center-box">
          <img id="ritual-center-img" src="{{ 'argile-purifiante.jpg' | asset_url }}" alt="Active ritual formulation" class="verenne-dial-center-photo" width="400" height="400">
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  .verenne-ritual-section {
    position: relative;
    overflow: hidden;
    background-color: #1A130E !important;
    color: #FAF6EE !important;
    padding: 6rem 1.25rem;
  }
  @media (min-width: 640px) {
    .verenne-ritual-section {
      padding: 8rem 2.5rem;
    }
  }
  .verenne-ritual-container {
    max-width: 1600px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .verenne-ritual-container {
      grid-template-columns: 5fr 7fr;
      gap: 5rem;
    }
  }
  .verenne-ritual-eyebrow {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #A39585 !important;
    margin: 0 0 1rem 0;
  }
  .verenne-ritual-headline {
    font-family: 'Bodoni Moda', serif;
    font-size: clamp(2.6rem, 5vw, 4.5rem);
    line-height: 0.95;
    color: #FAF6EE !important;
    margin: 0;
  }
  .verenne-ritual-accent-text {
    font-family: 'Bodoni Moda', serif;
    font-style: italic;
    color: #E0935F !important;
  }
  .verenne-ritual-pill-tabs {
    display: inline-flex;
    border: 1px solid rgba(239, 231, 218, 0.2);
    border-radius: 9999px;
    padding: 0.25rem;
    margin: 2rem 0;
    gap: 0.25rem;
    background: rgba(26, 19, 14, 0.6);
  }
  .verenne-mode-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem;
    border-radius: 9999px;
    border: none;
    background: transparent;
    color: #A39585;
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 0.8125rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .verenne-mode-btn.active {
    background: #FAF6EE !important;
    color: #1A130E !important;
    font-weight: 500;
  }
  .verenne-steps-list {
    border-top: 1px solid rgba(239, 231, 218, 0.15);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .verenne-ritual-row {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid rgba(239, 231, 218, 0.15);
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .verenne-row-time {
    font-family: 'Hanken Grotesk', monospace, sans-serif;
    font-size: 0.75rem;
    color: #A39585 !important;
  }
  .verenne-row-verb {
    font-family: 'Bodoni Moda', serif;
    font-size: 1.85rem;
    color: #A39585;
    transition: all 0.3s ease;
  }
  .verenne-ritual-row.active .verenne-row-verb {
    color: #FAF6EE !important;
    font-style: italic;
    transform: translateX(4px);
  }
  .verenne-row-product {
    margin-left: auto;
    text-align: right;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .verenne-product-name {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 0.875rem;
    color: #C2B5A4 !important;
  }
  .verenne-product-price {
    font-family: 'Hanken Grotesk', monospace, sans-serif;
    font-size: 0.75rem;
    color: #A39585 !important;
  }
  .verenne-ritual-footer-action {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }
  .verenne-btn-add-routine {
    background: #99481F !important;
    color: #FAF6EE !important;
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.95rem 1.75rem;
    border-radius: 9999px;
    border: none;
    cursor: pointer;
    transition: background 0.3s ease;
  }
  .verenne-btn-add-routine:hover {
    background: #b85a27 !important;
  }
  .verenne-ritual-ships-label {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #A39585 !important;
  }
  /* Dial Container */
  .verenne-dial-wrap {
    position: relative;
    width: 100%;
    max-width: 580px;
    aspect-ratio: 1 / 1;
    margin: 0 auto;
  }
  .verenne-dial-svg-plate {
    position: absolute;
    inset: 0;
    transition: transform 1.6s cubic-bezier(0.83, 0, 0.17, 1);
  }
  .verenne-dial-svg {
    width: 100%;
    height: 100%;
  }
  .verenne-orbit-nodes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .verenne-orbit-node {
    position: absolute;
    transform: translate(-50%, -50%);
    background: transparent;
    border: none;
    cursor: pointer;
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    transition: transform 0.4s ease;
  }
  .verenne-orbit-node.active {
    transform: translate(-50%, -50%) scale(1.15);
  }
  .verenne-node-thumb-wrap {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 9999px;
    border: 2px solid rgba(239, 231, 218, 0.2);
    overflow: hidden;
    background: #1A130E;
    transition: border-color 0.3s ease;
  }
  @media (min-width: 640px) {
    .verenne-node-thumb-wrap {
      width: 4rem;
      height: 4rem;
    }
  }
  .verenne-orbit-node.active .verenne-node-thumb-wrap {
    border-color: #FAF6EE !important;
  }
  .verenne-node-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .verenne-node-num {
    font-family: 'Hanken Grotesk', monospace, sans-serif;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: #A39585 !important;
  }
  .verenne-orbit-node.active .verenne-node-num {
    color: #FAF6EE !important;
    font-weight: 600;
  }
  .verenne-dial-center-box {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 42%;
    height: 52%;
    border: 1px solid rgba(239, 231, 218, 0.25);
    background: #1A130E;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0,0,0,0.5);
  }
  .verenne-dial-center-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s ease;
  }
</style>

<script>
  const RITUAL_DATA = {
    dawn: {
      subtitle: 'Every morning.',
      total: 336,
      steps: [
        {
          id: 'argile-purifiante',
          time: '07:00',
          verb: 'Cleanse',
          name: 'Argile Purifiante',
          price: 58,
          image: "{{ 'argile-purifiante.jpg' | asset_url }}",
          thumb: "{{ 'argile-purifiante.jpg' | asset_url }}"
        },
        {
          id: 'brume-botanique',
          time: '07:02',
          verb: 'Mist',
          name: 'Brume Botanique',
          price: 68,
          image: "{{ 'brume-botanique.jpg' | asset_url }}",
          thumb: "{{ 'brume-botanique.jpg' | asset_url }}"
        },
        {
          id: 'eclat-sauvage',
          time: '07:03',
          verb: 'Illuminate',
          name: 'Éclat Sauvage',
          price: 118,
          image: "{{ 'eclat-sauvage.jpg' | asset_url }}",
          thumb: "{{ 'eclat-sauvage.jpg' | asset_url }}"
        },
        {
          id: 'creme-radieuse',
          time: '07:05',
          verb: 'Veil',
          name: 'Crème Radieuse',
          price: 92,
          image: "{{ 'creme-radieuse.jpg' | asset_url }}",
          thumb: "{{ 'creme-radieuse.jpg' | asset_url }}"
        }
      ]
    },
    dusk: {
      subtitle: 'Twice at night.',
      total: 355,
      steps: [
        {
          id: 'argile-purifiante',
          time: '22:00',
          verb: 'Dissolve',
          name: 'Argile Purifiante',
          price: 58,
          image: "{{ 'argile-purifiante.jpg' | asset_url }}",
          thumb: "{{ 'argile-purifiante.jpg' | asset_url }}"
        },
        {
          id: 'brume-botanique',
          time: '22:02',
          verb: 'Quench',
          name: 'Brume Botanique',
          price: 68,
          image: "{{ 'brume-botanique.jpg' | asset_url }}",
          thumb: "{{ 'brume-botanique.jpg' | asset_url }}"
        },
        {
          id: 'seve-doree',
          time: '22:04',
          verb: 'Renew',
          name: 'Sève Dorée',
          price: 135,
          image: "{{ 'seve-doree.jpg' | asset_url }}",
          thumb: "{{ 'seve-doree.jpg' | asset_url }}"
        },
        {
          id: 'baume-resineux',
          time: '22:06',
          verb: 'Seal',
          name: 'Baume Résineux',
          price: 94,
          image: "{{ 'baume-resineux.jpg' | asset_url }}",
          thumb: "{{ 'baume-resineux.jpg' | asset_url }}"
        }
      ]
    }
  };

  let currentRitualMode = 'dawn';
  let currentRitualStep = 0;

  function switchRitualMode(mode) {
    currentRitualMode = mode;
    currentRitualStep = 0;

    const isDawn = mode === 'dawn';
    const dawnBtn = document.getElementById('btn-ritual-dawn');
    const duskBtn = document.getElementById('btn-ritual-dusk');
    if (dawnBtn) {
      dawnBtn.classList.toggle('active', isDawn);
      dawnBtn.setAttribute('aria-selected', isDawn);
    }
    if (duskBtn) {
      duskBtn.classList.toggle('active', !isDawn);
      duskBtn.setAttribute('aria-selected', !isDawn);
    }

    const plate = document.getElementById('verenne-dial-plate');
    if (plate) {
      plate.style.transform = isDawn ? 'rotate(0deg)' : 'rotate(180deg)';
    }

    const data = RITUAL_DATA[mode];
    const sub = document.getElementById('ritual-mode-subtitle');
    const addBtn = document.getElementById('ritual-add-all-btn');
    if (sub) sub.textContent = data.subtitle;
    if (addBtn) addBtn.textContent = 'Add the ' + mode + ' ritual — $' + data.total;

    renderRitualSteps();
    renderOrbitNodes();
    updateRitualCenterPhoto();
  }

  function setRitualStep(idx) {
    currentRitualStep = idx;
    const items = document.querySelectorAll('.verenne-ritual-row');
    items.forEach((item, i) => {
      item.classList.toggle('active', i === idx);
    });

    const nodes = document.querySelectorAll('.verenne-orbit-node');
    nodes.forEach((node, i) => {
      node.classList.toggle('active', i === idx);
    });

    updateRitualCenterPhoto();
  }

  function updateRitualCenterPhoto() {
    const data = RITUAL_DATA[currentRitualMode];
    const s = data.steps[currentRitualStep];
    const img = document.getElementById('ritual-center-img');
    if (img && s) {
      img.src = s.image;
      img.alt = s.verb + ' — ' + s.name;
    }
  }

  function renderRitualSteps() {
    const data = RITUAL_DATA[currentRitualMode];
    const container = document.getElementById('ritual-steps-container');
    if (!container) return;
    container.innerHTML = '';

    data.steps.forEach((s, idx) => {
      const li = document.createElement('li');
      li.className = 'verenne-ritual-row' + (idx === currentRitualStep ? ' active' : '');
      li.onclick = () => setRitualStep(idx);
      li.onmouseenter = () => setRitualStep(idx);

      li.innerHTML = `
        <span class="verenne-row-time">${s.time}</span>
        <span class="verenne-row-verb">${s.verb}</span>
        <span class="verenne-row-product">
          <span class="verenne-product-name">${s.name}</span>
          <span class="verenne-product-price">$${s.price}</span>
        </span>
      `;
      container.appendChild(li);
    });
  }

  function renderOrbitNodes() {
    const data = RITUAL_DATA[currentRitualMode];
    const container = document.getElementById('ritual-orbit-nodes');
    if (!container) return;
    container.innerHTML = '';

    const angles = [45, 135, 225, 315];
    const r = 41;

    data.steps.forEach((s, idx) => {
      const angleRad = (angles[idx] - 90) * (Math.PI / 180);
      const leftPct = 50 + Math.cos(angleRad) * r;
      const topPct = 50 + Math.sin(angleRad) * r;

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'verenne-orbit-node' + (idx === currentRitualStep ? ' active' : '');
      btn.style.left = leftPct + '%';
      btn.style.top = topPct + '%';
      btn.setAttribute('aria-label', s.verb + ': ' + s.name);
      btn.onclick = () => setRitualStep(idx);

      const numStr = String(idx + 1).padStart(2, '0');
      btn.innerHTML = `
        <span class="verenne-node-thumb-wrap">
          <img src="${s.thumb}" alt="${s.name}" class="verenne-node-thumb" loading="lazy" />
        </span>
        <span class="verenne-node-num">${numStr}</span>
      `;
      container.appendChild(btn);
    });
  }

  function addAllRitualToBag() {
    const data = RITUAL_DATA[currentRitualMode];
    data.steps.forEach((s, idx) => {
      setTimeout(() => {
        if (typeof window.addVerenneCartItem === 'function') {
          window.addVerenneCartItem('N°' + (idx + 1) + ' ' + s.name, '$' + s.price, 'Standard', s.image);
        }
      }, idx * 120);
    });
  }

  // Initialize on Load
  document.addEventListener('DOMContentLoaded', () => {
    renderRitualSteps();
    renderOrbitNodes();
    updateRitualCenterPhoto();
  });
</script>

{% schema %}
{
  "name": "Verenne Ritual",
  "class": "section-verenne-ritual",
  "settings": [],
  "presets": [
    {
      "name": "Verenne Ritual"
    }
  ]
}
{% endschema %}
