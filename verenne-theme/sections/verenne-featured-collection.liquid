      title: 'Barrier Cocoon',
      blurb: 'Rich balms, night butters and eye care.'
    }
  };

  let currentModalIndex = 0;
  let currentSelectedSizeIdx = 0;
  let currentModalQty = 1;
  let currentModalView = 'bottle';

  // Three.js Scene Variables
  let threeRenderer = null;
  let threeScene = null;
  let threeCamera = null;
  let threeBottleGroup = null;
  let threeAnimFrame = null;
  let isDragging3D = false;
  let previousMousePosition = { x: 0, y: 0 };

  // Category Filtering
  function filterVerenneCategory(cat, btn) {
    document.querySelectorAll('.verenne-cat-btn').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');

    const titleEl = document.getElementById('verenne-cat-title');
    const blurbEl = document.getElementById('verenne-cat-blurb');
    if (CATEGORY_META[cat]) {
      if (titleEl) titleEl.textContent = CATEGORY_META[cat].title;
      if (blurbEl) blurbEl.textContent = CATEGORY_META[cat].blurb;
    }

    const grid = document.getElementById('verenne-product-list');
    if (grid) {
      if (cat === 'all') {
        grid.classList.add('is-editorial');
      } else {
        grid.classList.remove('is-editorial');
      }
    }

    const items = document.querySelectorAll('.verenne-grid-item');
    items.forEach(item => {
      const itemCat = item.getAttribute('data-category');
      if (cat === 'all' || itemCat === cat) {
        item.style.display = '';
      } else {
        item.style.display = 'none';
      }
    });
  }

  // Open Dossier Modal
  function openVerenneModal(index) {
    const p = VERENNE_DATA[index];
    if (!p) return;
    currentModalIndex = index;
    currentSelectedSizeIdx = 0;
    currentModalQty = 1;

    // Populate Eyebrow & Title
    document.getElementById('modal-no').textContent = 'N°' + p.no;
    document.getElementById('modal-category').textContent = p.category + ' · ' + p.subtitle;
    document.getElementById('dossier-title').textContent = p.name;
    document.getElementById('modal-subtitle').textContent = p.subtitle;
    document.getElementById('modal-reviews-text').textContent = p.rating + ' · ' + p.reviewsCount + ' reviews';

    // Populate Specs
    document.getElementById('modal-ph').textContent = p.ph || '5.2 (Skin-neutral)';
    document.getElementById('modal-finish').textContent = p.finish || 'Lit-from-within satin';
    document.getElementById('modal-desc').textContent = p.description;

    // Populate Images
    document.getElementById('modal-bottle-img').src = p.bottle;
    document.getElementById('modal-skin-img').src = p.portrait;

    // Populate Sizes
    const sizesWrap = document.getElementById('modal-sizes-wrap');
    sizesWrap.innerHTML = '';
    if (p.sizes && p.sizes.length > 0) {
      p.sizes.forEach((s, sIdx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'verenne-size-btn' + (sIdx === 0 ? ' active' : '');
        btn.textContent = s.size;
        btn.onclick = () => selectModalSize(sIdx);
        sizesWrap.appendChild(btn);
      });
      updateModalPrice();
    } else {
      document.getElementById('modal-buy-price').textContent = p.price;
    }

    document.getElementById('modal-qty-val').textContent = '1';

    // Populate Detailed Accordion / Specs
    document.getElementById('modal-texture').textContent = p.texture || 'Weightless golden micro-oil';
    document.getElementById('modal-notes').textContent = (p.notes && p.notes.join(' · ')) || 'Immortelle · Neroli · Cedar';
    document.getElementById('modal-how').textContent = p.howToUse || 'Warm between palms and press into damp skin.';

    const tagsWrap = document.getElementById('modal-botanicals-tags');
    tagsWrap.innerHTML = '';
    if (p.keyIngredients) {
      p.keyIngredients.forEach(ing => {
        const span = document.createElement('span');
        span.className = 'verenne-tag-pill';
        span.textContent = ing;
        tagsWrap.appendChild(span);
      });
    }

    // Default to Bottle View
    switchVerenneView('bottle');

    // Show Overlay
    const overlay = document.getElementById('verenne-modal-overlay');
    overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function selectModalSize(idx) {
    currentSelectedSizeIdx = idx;
    document.querySelectorAll('.verenne-size-btn').forEach((b, i) => {
      b.classList.toggle('active', i === idx);
    });
    updateModalPrice();
  }

  function updateModalPrice() {
    const p = VERENNE_DATA[currentModalIndex];
    if (!p) return;
    const basePrice = (p.sizes && p.sizes[currentSelectedSizeIdx]) ? p.sizes[currentSelectedSizeIdx].price : p.rawPrice;
    document.getElementById('modal-buy-price').textContent = '$' + (basePrice * currentModalQty);
  }

  function adjustModalQty(delta) {
    currentModalQty = Math.max(1, currentModalQty + delta);
    document.getElementById('modal-qty-val').textContent = currentModalQty;
    updateModalPrice();
  }

  function toggleModalWishlist(btn) {
    btn.classList.toggle('active');
    btn.textContent = btn.classList.contains('active') ? '♥' : '♡';
  }

  function closeVerenneModal() {
    const overlay = document.getElementById('verenne-modal-overlay');
    overlay.classList.remove('active');
    document.body.style.overflow = '';
    if (threeAnimFrame) {
      cancelAnimationFrame(threeAnimFrame);
      threeAnimFrame = null;
    }
  }

  function closeVerenneModalOnBackdrop(e) {
    if (e.target && e.target.id === 'verenne-modal-overlay') {
      closeVerenneModal();
    }
  }

  // View Switcher (Bottle / On skin / View in 3D)
  function switchVerenneView(view) {
    currentModalView = view;
    document.querySelectorAll('.verenne-view-panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.verenne-view-btn').forEach(b => b.classList.remove('active'));

    const activePanel = document.getElementById('verenne-view-' + view);
    const activeBtn = document.getElementById('btn-view-' + view);
    if (activePanel) activePanel.classList.add('active');
    if (activeBtn) activeBtn.classList.add('active');

    if (view === '3d') {
      initThreeBottle(VERENNE_DATA[currentModalIndex]);
    } else {
      if (threeAnimFrame) {
        cancelAnimationFrame(threeAnimFrame);
        threeAnimFrame = null;
      }
    }
  }

  // Pointer-Driven Tactile Magnifying Lens
  function handleLensZoom(e) {
    const container = document.getElementById('verenne-zoom-container');
    const magnifier = document.getElementById('verenne-magnifier');
    const img = document.getElementById('modal-bottle-img');
    if (!container || !magnifier || !img || !img.src) return;

    const rect = container.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;

    if (x < 0 || y < 0 || x > rect.width || y > rect.height) {
      magnifier.style.display = 'none';
      return;
    }

    magnifier.style.display = 'block';
    magnifier.style.left = x + 'px';
    magnifier.style.top = y + 'px';
    magnifier.style.backgroundImage = 'url(' + img.src + ')';
    magnifier.style.backgroundSize = (rect.width * 2.8) + 'px ' + (rect.height * 2.8) + 'px';

    const bgX = (x / rect.width) * 100;
    const bgY = (y / rect.height) * 100;
    magnifier.style.backgroundPosition = bgX + '% ' + bgY + '%';
  }

  function handleLensTouch(e) {
    if (!e.touches || e.touches.length === 0) return;
    const touch = e.touches[0];
    handleLensZoom({ clientX: touch.clientX, clientY: touch.clientY });
  }

  function hideLensZoom() {
    const magnifier = document.getElementById('verenne-magnifier');
    if (magnifier) magnifier.style.display = 'none';
  }

  // Add to Bag Handlers with Toast & Cart Integration
  function handleVerenneAdd(btn, title, price, index) {
    const p = VERENNE_DATA[index];
    const sizeName = (p && p.sizes && p.sizes[0]) ? p.sizes[0].size : 'Standard';
    postVerenneItemToCart(title, price, sizeName, 1);
  }

  function addCurrentModalToBag() {
    const p = VERENNE_DATA[currentModalIndex];
    if (!p) return;
    const size = (p.sizes && p.sizes[currentSelectedSizeIdx]) ? p.sizes[currentSelectedSizeIdx].size : 'Standard';
    const price = document.getElementById('modal-buy-price').textContent;
    postVerenneItemToCart(p.fullName, price, size, currentModalQty);
    closeVerenneModal();
  }

  function postVerenneItemToCart(title, price, size, qty) {
    // Show Toast
    showVerenneToast('Added ' + title + ' (' + size + ') to bag · ' + price);

    // Update Header Bag Counter
    const bagCounts = document.querySelectorAll('.verenne-bag-count');
    bagCounts.forEach(el => {
      let current = parseInt(el.textContent.replace(/[^0-9]/g, '')) || 0;
      el.textContent = current + qty;
    });

    // Post to Shopify Cart API
    fetch(window.Shopify ? window.Shopify.routes.root + 'cart/add.js' : '/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({
        items: [{
          quantity: qty,
          properties: { 'Formulation': title, 'Volume': size, 'Curated': 'Verenne Grasse Edition' }
        }]
      })
    }).catch(() => {});
  }

  function showVerenneToast(msg) {
    let toast = document.getElementById('verenne-floating-toast');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'verenne-floating-toast';
      toast.className = 'verenne-toast';
      document.body.appendChild(toast);
    }
    toast.innerHTML = '<span class="verenne-toast-dot"></span> ' + msg;
    toast.classList.add('visible');
    setTimeout(() => {
      toast.classList.remove('visible');
    }, 3800);
  }

  // Three.js Procedural WebGL Glass Flacon
  function initThreeBottle(product) {
    const canvas = document.getElementById('verenne-three-canvas');
    if (!canvas || typeof THREE === 'undefined') return;

    if (threeAnimFrame) {
      cancelAnimationFrame(threeAnimFrame);
      threeAnimFrame = null;
    }

    const container = canvas.parentElement;
    const width = container.clientWidth || 450;
    const height = container.clientHeight || 550;

    if (!threeRenderer) {
      threeRenderer = new THREE.WebGLRenderer({ canvas: canvas, alpha: true, antialias: true, powerPreference: 'high-performance' });
      threeRenderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      threeRenderer.setSize(width, height);
      threeRenderer.toneMapping = THREE.ACESFilmicToneMapping;
      threeRenderer.toneMappingExposure = 1.25;

      threeScene = new THREE.Scene();
      threeCamera = new THREE.PerspectiveCamera(38, width / height, 0.1, 100);
      threeCamera.position.set(0, 0, 5.2);

      // Studio Lighting
      const amb = new THREE.AmbientLight(0xfff5eb, 1.4);
      threeScene.add(amb);

      const dirLight = new THREE.DirectionalLight(0xffffff, 2.8);
      dirLight.position.set(4, 6, 4);
      threeScene.add(dirLight);

      const rimLight = new THREE.DirectionalLight(0xd99058, 2.2);
      rimLight.position.set(-4, -2, -3);
      threeScene.add(rimLight);

      // Drag to rotate controls
      canvas.addEventListener('mousedown', (e) => {
        isDragging3D = true;
        previousMousePosition = { x: e.clientX, y: e.clientY };
      });
      window.addEventListener('mouseup', () => { isDragging3D = false; });
      canvas.addEventListener('mousemove', (e) => {
        if (!isDragging3D || !threeBottleGroup) return;
        const deltaX = e.clientX - previousMousePosition.x;
        const deltaY = e.clientY - previousMousePosition.y;
        threeBottleGroup.rotation.y += deltaX * 0.012;
        threeBottleGroup.rotation.x += deltaY * 0.008;
        previousMousePosition = { x: e.clientX, y: e.clientY };
      });

      canvas.addEventListener('touchstart', (e) => {
        if (e.touches.length > 0) {
          isDragging3D = true;
          previousMousePosition = { x: e.touches[0].clientX, y: e.touches[0].clientY };
        }
      });
      window.addEventListener('touchend', () => { isDragging3D = false; });
      canvas.addEventListener('touchmove', (e) => {
        if (!isDragging3D || !threeBottleGroup || e.touches.length === 0) return;
        const deltaX = e.touches[0].clientX - previousMousePosition.x;
        const deltaY = e.touches[0].clientY - previousMousePosition.y;
        threeBottleGroup.rotation.y += deltaX * 0.012;
        threeBottleGroup.rotation.x += deltaY * 0.008;
        previousMousePosition = { x: e.clientX, y: e.clientY };
      });
    } else {
      threeRenderer.setSize(width, height);
      threeCamera.aspect = width / height;
      threeCamera.updateProjectionMatrix();
    }

    if (threeBottleGroup) {
      threeScene.remove(threeBottleGroup);
    }
    threeBottleGroup = new THREE.Group();

    const liquidHex = (product && product.color) ? parseInt(product.color.replace('#', '0x')) : 0xc8782a;

    // 1. Violet/Amber Miron Glass Body
    const glassMat = new THREE.MeshPhysicalMaterial({
      color: 0x18110b,
      roughness: 0.08,
      metalness: 0.1,
      transmission: 0.65,
      ior: 1.52,
      thickness: 1.2,
      transparent: true,
      opacity: 0.94
    });
    const bodyGeom = new THREE.CylinderGeometry(0.72, 0.72, 1.85, 48);
    const bodyMesh = new THREE.Mesh(bodyGeom, glassMat);
    threeBottleGroup.add(bodyMesh);

    // 2. Liquid Tincture Column Inside
    const liquidMat = new THREE.MeshStandardMaterial({
      color: liquidHex,
      roughness: 0.2,
      metalness: 0.15,
      transparent: true,
      opacity: 0.78
    });
    const liquidGeom = new THREE.CylinderGeometry(0.66, 0.66, 1.65, 36);
    const liquidMesh = new THREE.Mesh(liquidGeom, liquidMat);
    liquidMesh.position.y = -0.05;
    threeBottleGroup.add(liquidMesh);

    // 3. Gold Knurled Collar
    const goldMat = new THREE.MeshStandardMaterial({
      color: 0xd4a359,
      roughness: 0.28,
      metalness: 0.92
    });
    const collarGeom = new THREE.CylinderGeometry(0.38, 0.44, 0.28, 36);
    const collarMesh = new THREE.Mesh(collarGeom, goldMat);
    collarMesh.position.y = 1.05;
    threeBottleGroup.add(collarMesh);

    // 4. Black Dropper Neck
    const neckMat = new THREE.MeshStandardMaterial({ color: 0x111111, roughness: 0.4 });
    const neckGeom = new THREE.CylinderGeometry(0.26, 0.26, 0.42, 32);
    const neckMesh = new THREE.Mesh(neckGeom, neckMat);
    neckMesh.position.y = 1.35;
    threeBottleGroup.add(neckMesh);

    // 5. Rubber Bulb
    const bulbMat = new THREE.MeshStandardMaterial({ color: 0x1a1a1a, roughness: 0.85 });
    const bulbGeom = new THREE.SphereGeometry(0.28, 32, 24);
    bulbGeom.scale(1, 1.45, 1);
    const bulbMesh = new THREE.Mesh(bulbGeom, bulbMat);
    bulbMesh.position.y = 1.72;
    threeBottleGroup.add(bulbMesh);

    // 6. Label with Gold Hairlines
    const labelCanvas = document.createElement('canvas');
    labelCanvas.width = 1024;
    labelCanvas.height = 768;
    const ctx = labelCanvas.getContext('2d');
    ctx.fillStyle = '#FAF6EE';
    ctx.fillRect(0, 0, 1024, 768);
    ctx.strokeStyle = '#C99E64';
    ctx.lineWidth = 6;
    ctx.strokeRect(32, 32, 960, 704);
    ctx.strokeRect(44, 44, 936, 680);
    ctx.fillStyle = '#1A130E';
    ctx.font = '600 48px Bodoni Moda, serif';
    ctx.textAlign = 'center';
    ctx.fillText('VERENNE', 512, 170);
    ctx.font = '500 24px Hanken Grotesk, sans-serif';
    ctx.letterSpacing = '6px';
    ctx.fillText('PARIS · GRASSE', 512, 220);
    ctx.strokeStyle = '#D9822B';
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(380, 270);
    ctx.lineTo(644, 270);
    ctx.stroke();
    ctx.fillStyle = '#1A130E';
    ctx.font = '400 36px Bodoni Moda, serif';
    ctx.fillText(product ? product.fullName : 'N°01 ÉCLAT SAUVAGE', 512, 350);
    ctx.font = 'italic 26px Bodoni Moda, serif';
    ctx.fillStyle = '#5A4634';
    ctx.fillText(product ? product.subtitle : 'Active botanical serum', 512, 400);
    ctx.font = '300 20px Hanken Grotesk, sans-serif';
    ctx.fillStyle = '#6E5844';
    ctx.fillText('FLACON BIO-CHROMATOGRAPHIQUE', 512, 540);
    ctx.fillText('ÉDITION LIMITÉE · 400 FLACONS', 512, 580);
    ctx.font = '500 22px Hanken Grotesk, sans-serif';
    ctx.fillStyle = '#1A130E';
    ctx.fillText('50 ML · 1.7 FL. OZ', 512, 650);

    const labelTex = new THREE.CanvasTexture(labelCanvas);
    const labelMat = new THREE.MeshBasicMaterial({ map: labelTex, transparent: true, opacity: 0.96 });
    const labelGeom = new THREE.CylinderGeometry(0.725, 0.725, 1.25, 48, 1, true, -Math.PI * 0.45, Math.PI * 0.9);
    const labelMesh = new THREE.Mesh(labelGeom, labelMat);
    threeBottleGroup.add(labelMesh);

    threeBottleGroup.position.y = -0.35;
    threeScene.add(threeBottleGroup);

    // Animation Loop
    function animate() {
      threeAnimFrame = requestAnimationFrame(animate);
      if (!isDragging3D && threeBottleGroup) {
        threeBottleGroup.rotation.y += 0.0075;
      }
      threeRenderer.render(threeScene, threeCamera);
    }
    animate();
  }
</script>

