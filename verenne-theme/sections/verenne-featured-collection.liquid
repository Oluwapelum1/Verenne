<!-- ==========================================================================
     VERENNE PRODUCT DETAIL MODAL (Bottle · On Skin Portrait · 3D Flacon)
     ========================================================================== -->
<div id="verenne-modal-backdrop" class="verenne-modal-backdrop" onclick="closeVerenneModal(event)">
  <div class="verenne-modal-dialog" onclick="event.stopPropagation()">
    <button type="button" class="verenne-modal-close-btn" onclick="closeVerenneModal()" aria-label="Close modal">&times;</button>
    
    <div class="verenne-modal-grid">
      <!-- Left Column: Visual Explorer (Bottle / On skin / 3D) -->
      <div class="verenne-modal-media-col">
        <div class="verenne-modal-viewport">
          <!-- Bottle View with Tactile Magnifying Lens -->
          <div id="verenne-view-bottle" class="verenne-modal-view-panel active">
            <div class="verenne-bottle-zoom-wrap" id="verenne-bottle-zoom-wrap">
              <img id="verenne-modal-bottle-img" src="{{ 'eclat-sauvage.jpg' | asset_url }}" alt="Formulation bottle" class="verenne-modal-img" width="600" height="750">
              <div id="verenne-magnifier-lens" class="verenne-magnifier-lens" aria-hidden="true"></div>
            </div>
          </div>

          <!-- On Skin View -->
          <div id="verenne-view-portrait" class="verenne-modal-view-panel">
            <img id="verenne-modal-portrait-img" src="{{ 'model_oil_glow.jpg' | asset_url }}" alt="Formulation on skin" class="verenne-modal-img" width="600" height="750">
          </div>

          <!-- 3D Interactive View -->
          <div id="verenne-view-3d" class="verenne-modal-view-panel">
            <div class="verenne-3d-scene" id="verenne-3d-container">
              <div class="verenne-3d-flacon" id="verenne-3d-flacon">
                <div class="flacon-body" id="flacon-body-color">
                  <div class="flacon-label">
                    <span class="flacon-crest">VERENNE</span>
                    <span id="flacon-label-name" class="flacon-name">ÉCLAT SAUVAGE</span>
                    <span class="flacon-origin">PARIS · GRASSE</span>
                  </div>
                </div>
                <div class="flacon-cap"></div>
              </div>
            </div>
            <p class="verenne-3d-hint">Drag or swipe to rotate 3D flacon</p>
          </div>
        </div>

        <!-- View Switcher Tabs -->
        <div class="verenne-modal-view-tabs" role="tablist">
          <button type="button" class="verenne-modal-tab-btn active" id="tab-bottle" onclick="switchVerenneModalView('bottle')">Bottle</button>
          <button type="button" class="verenne-modal-tab-btn" id="tab-portrait" onclick="switchVerenneModalView('portrait')">On skin</button>
          <button type="button" class="verenne-modal-tab-btn" id="tab-3d" onclick="switchVerenneModalView('3d')">View in 3D</button>
        </div>
      </div>

      <!-- Right Column: Archival Dossier & Add to Bag -->
      <div class="verenne-modal-info-col">
        <p class="verenne-caption" id="modal-category">FORMULATION DOSSIER</p>
        <h2 class="verenne-heading verenne-modal-title" id="modal-title">N°01 Éclat Sauvage</h2>
        <p class="verenne-modal-latin" id="modal-latin">Helichrysum stoechas</p>
