{%- comment -%}
  Verenne Featured Collection
  Renders real Shopify products or graceful onboarding placeholders
{%- endcomment -%}

<section class="verenne-collection-section" aria-labelledby="verenne-collection-heading-{{ section.id }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="verenne-section-header">
    <div>
      {%- if section.settings.caption != blank -%}
        <p class="verenne-caption">{{ section.settings.caption | escape }}</p>
      {%- endif -%}

      <h2 id="verenne-collection-heading-{{ section.id }}" class="verenne-heading" style="font-size: clamp(2rem, 3.8vw, 3.2rem); margin-top: 0.5rem;">
        {{ section.settings.title | escape }}
      </h2>
    </div>

    {%- if section.settings.show_view_all and section.settings.collection != blank -%}
      <a href="{{ section.settings.collection.url }}" class="verenne-pill-btn verenne-pill-btn--outline">
        View All Formulations &rarr;
      </a>
    {%- endif -%}
  </div>

  {%- assign current_collection = collections[section.settings.collection] -%}
  {%- assign products_to_display = current_collection.products | default: collections.all.products -%}

  <div class="verenne-product-grid" style="grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);">
    {%- if products_to_display.size > 0 -%}
      {%- for product in products_to_display limit: section.settings.products_to_show -%}
        <article class="verenne-product-card">
          <a href="{{ product.url }}" class="verenne-card-media" aria-label="{{ product.title | escape }}">
            {%- if product.featured_image != blank -%}
              {%- assign card_alt = product.featured_image.alt | default: product.title | escape -%}
              {{
                product.featured_image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  widths: '320, 600, 800',
                  sizes: '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw',
                  alt: card_alt,
                  class: 'verenne-card-img'
              }}
            {%- else -%}
              <div class="verenne-card-placeholder">
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg verenne-placeholder-svg' }}
              </div>
            {%- endif -%}
          </a>

          <div class="verenne-card-details">
            <div class="verenne-card-meta">
              <span>{{ product.type | default: 'Botanical Formulation' }}</span>
              {%- if section.settings.show_stock_badge -%}
                {%- if product.available -%}
                  <span style="color: var(--verenne-gold); font-size: 0.7rem; letter-spacing: 0.05em; text-transform: uppercase;">In stock</span>
                {%- else -%}
                  <span style="color: var(--verenne-text-muted); font-size: 0.7rem; letter-spacing: 0.05em; text-transform: uppercase;">Allocated</span>
                {%- endif -%}
              {%- endif -%}
            </div>

            <h3 class="verenne-card-title">
              <a href="{{ product.url }}">{{ product.title | escape }}</a>
            </h3>

            <div class="verenne-card-price">
              <span>{{ product.price | money }}</span>
              {%- if product.compare_at_price > product.price -%}
                <s style="color: var(--verenne-text-muted); font-size: 0.85em; margin-left: 0.5rem;">
                  {{ product.compare_at_price | money }}
                </s>
              {%- endif -%}
            </div>

            <form method="post" action="{{ routes.cart_add_url }}" class="verenne-card-form">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button
                type="submit"
                class="verenne-card-btn"
                {% unless product.available %}disabled{% endunless %}
              >
                {%- if product.available -%}
                  + Add to Bag
                {%- else -%}
                  Sold Out
                {%- endif -%}
              </button>
            </form>
          </div>
        </article>
      {%- endfor -%}
    {%- else -%}
      {%- comment -%}
        Shopify Haute-Botanique Complete Onboarding:
        Displays complete flagship formulations with high-resolution studio photography
        when the store has no products imported yet.
      {%- endcomment -%}
      {%- assign dummy_names = "N°01 Éclat Sauvage,N°02 Baume Résineux,N°03 Brume Botanique,N°04 Élixir Nocturne,N°05 Argile Purifiante,N°06 Huile Démaquillante,N°07 Baume Régénérant,N°08 Essence Fleurie" | split: "," -%}
      {%- assign dummy_types = "Active Serum,Ceramide Salve,Damask Hydrosol,Cellular Elixir,Botanical Clay,Cleansing Oil,Lipid Balm,Hydrating Essence" | split: "," -%}
      {%- assign dummy_prices = "$118,$94,$68,$160,$68,$74,$128,$92" | split: "," -%}
      {%- assign dummy_images = "https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=800&q=80,https://images.unsplash.com/photo-1608248597359-002779a5e1bb?auto=format&fit=crop&w=800&q=80,https://images.unsplash.com/photo-1617897903246-719242758050?auto=format&fit=crop&w=800&q=80,https://images.unsplash.com/photo-1601049541289-9b1b7bbbfe19?auto=format&fit=crop&w=800&q=80,https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&w=800&q=80,https://images.unsplash.com/photo-1571781926291-c477ebfd024b?auto=format&fit=crop&w=800&q=80,https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?auto=format&fit=crop&w=800&q=80,https://images.unsplash.com/photo-1535585209827-a15fcdbc4c2d?auto=format&fit=crop&w=800&q=80" | split: "," -%}

      {%- for i in (1..section.settings.products_to_show) -%}
        {%- assign idx = forloop.index0 | modulo: 8 -%}
        <article class="verenne-product-card">
          <div class="verenne-card-media">
            <img
              src="{{ dummy_images[idx] }}"
              alt="{{ dummy_names[idx] | escape }} — Haute-Botanique Formulation"
              class="verenne-card-img"
              loading="lazy"
              width="600"
              height="750"
            >
          </div>

          <div class="verenne-card-details">
            <div class="verenne-card-meta">
              <span>{{ dummy_types[idx] }}</span>
              <span style="color: var(--verenne-gold); font-size: 0.72rem; letter-spacing: 0.08em; font-weight: 600; text-transform: uppercase;">Numbered Batch</span>
            </div>

            <h3 class="verenne-card-title">
              <a href="{{ routes.all_products_collection_url }}">{{ dummy_names[idx] }}</a>
            </h3>

            <div class="verenne-card-price">
              <span>{{ dummy_prices[idx] }}</span>
            </div>

            <button type="button" class="verenne-card-btn">
              + Add to Bag
            </button>
          </div>
        </article>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "class": "section-verenne-collection",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "default": "(02) — THE COMPENDIUM",
      "label": "Caption eyebrow"
    },
    {
      "type": "text",
      "id": "title",
      "default": "Sixteen Active Formulations",
      "label": "Heading title"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "Products to display"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Columns on desktop"
    },
    {
      "type": "checkbox",
      "id": "show_stock_badge",
      "default": true,
      "label": "Show stock badge"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Show 'View all' link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Verenne Featured Collection"
    }
  ]
}
{% endschema %}
