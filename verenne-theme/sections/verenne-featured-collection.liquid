  function filterVerenneCategory(cat, btn) {
    document.querySelectorAll('.verenne-cat-btn').forEach(function(b) {
      b.classList.remove('active');
    });
    btn.classList.add('active');

    const blurbs = {
      all: 'Four steps, four formulas each. Pick a step or browse them all.',
      cleanse: 'Remove impurities and sunscreen without stripping your skin.',
      treat: 'Concentrated serums, peptides and overnight treatments.',
      hydrate: 'Mists, lotions and a weightless daily SPF.',
      restore: 'Rich balms, night butters and eye care.'
    };

    const blurbEl = document.getElementById('verenne-cat-blurb');
    if (blurbEl && blurbs[cat]) {
      blurbEl.textContent = blurbs[cat];
    }

    const items = document.querySelectorAll('.verenne-grid-item');
    items.forEach(function(item) {
      if (cat === 'all' || item.getAttribute('data-category') === cat) {
        item.classList.remove('hidden');
      } else {
        item.classList.add('hidden');
      }
    });
  }

  function handleVerenneAdd(btn, name, price) {
    const originalText = btn.textContent;
    btn.textContent = '✓ Added';
    btn.style.color = '#15803d';
    setTimeout(function() {
      btn.textContent = originalText;
      btn.style.color = '';
    }, 1800);
  }

  function openVerenneModal(index) {
    currentProductIndex = index;
    const p = VERENNE_DATA[index];
    if (!p) return;

    document.getElementById('modal-category').textContent = p.category;
    document.getElementById('modal-title').textContent = p.fullName;
    document.getElementById('modal-latin').textContent = p.latin;
    document.getElementById('modal-price').textContent = p.price;
    document.getElementById('modal-desc').textContent = p.desc;
    document.getElementById('modal-botanicals').textContent = p.botanicals;
    document.getElementById('modal-how').textContent = p.how;
    document.getElementById('modal-bioactive').textContent = p.bioactive;
    document.getElementById('modal-ph').textContent = p.ph;

    document.getElementById('verenne-modal-bottle-img').src = p.bottle;
    document.getElementById('verenne-modal-bottle-img').alt = p.fullName;

    document.getElementById('verenne-modal-portrait-img').src = p.portrait;
    document.getElementById('verenne-modal-portrait-img').alt = p.fullName + ' on skin';

    document.getElementById('flacon-label-name').textContent = p.fullName.toUpperCase();
    document.getElementById('flacon-body-color').style.backgroundColor = p.color;

    switchVerenneModalView('bottle');
    document.getElementById('verenne-modal-backdrop').classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeVerenneModal(e) {
    if (e && e.target !== e.currentTarget && !e.target.classList.contains('verenne-modal-close-btn')) return;
    document.getElementById('verenne-modal-backdrop').classList.remove('active');
    document.body.style.overflow = '';
  }

  function switchVerenneModalView(view) {
    document.querySelectorAll('.verenne-modal-tab-btn').forEach(function(btn) {
      btn.classList.remove('active');
    });
    document.querySelectorAll('.verenne-modal-view-panel').forEach(function(panel) {
      panel.classList.remove('active');
    });

    const activeTab = document.getElementById('tab-' + view);
    const activePanel = document.getElementById('verenne-view-' + view);
    if (activeTab) activeTab.classList.add('active');
    if (activePanel) activePanel.classList.add('active');
  }

