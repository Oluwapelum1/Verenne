<script>
  function filterVerenneCategory(cat, btn) {
    document.querySelectorAll('.verenne-cat-btn').forEach(function(b) {
      b.classList.remove('active');
    });
    btn.classList.add('active');

    const blurbs = {
      all: 'Four steps, four formulas each. Pick a step or browse them all.',
      cleanse: 'Remove impurities and sunscreen without stripping your skin.',
      treat: 'Concentrated serums, peptides and overnight treatments.',
      hydrate: 'Mists, lotions and a weightless daily SPF.',
      restore: 'Rich balms, night butters and eye care.'
    };

    const blurbEl = document.getElementById('verenne-cat-blurb');
    if (blurbEl && blurbs[cat]) {
      blurbEl.textContent = blurbs[cat];
    }

    const items = document.querySelectorAll('.verenne-grid-item');
    items.forEach(function(item) {
      if (cat === 'all' || item.getAttribute('data-category') === cat) {
        item.classList.remove('hidden');
      } else {
        item.classList.add('hidden');
      }
    });
  }

  function handleVerenneAdd(btn, name, price) {
    const originalText = btn.textContent;
    btn.textContent = '✓ Added';
    btn.style.color = '#86efac';
    setTimeout(function() {
      btn.textContent = originalText;
      btn.style.color = '';
    }, 1800);
  }
</script>

{% schema %}
{
  "name": "Featured Collection",
  "class": "section-verenne-collection",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "default": "(02) — THE COMPENDIUM",
      "label": "Caption eyebrow"
    },
    {
      "type": "text",
      "id": "title",
      "default": "All 16 formulations",
      "label": "Heading title"
    },
    {
      "type": "text",
      "id": "blurb",
      "default": "Four steps, four formulas each. Pick a step or browse them all.",
      "label": "Description blurb"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Verenne Featured Collection"
    }
  ]
}
{% endschema %}
