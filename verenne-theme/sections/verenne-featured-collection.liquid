<!-- Formulation Dossier Modal (Exact 1:1 match to GitHub webapp) -->
<div id="verenne-modal-overlay" class="verenne-modal-overlay" onclick="closeVerenneModalOnBackdrop(event)" role="dialog" aria-modal="true" aria-labelledby="dossier-title">
  <div class="verenne-modal-card">
    
    <!-- Left Media Column -->
    <div class="verenne-modal-media-col">
      <!-- 1. Bottle View with Pointer Magnifier -->
      <div id="verenne-view-bottle" class="verenne-modal-view-panel active">
        <div class="verenne-bottle-zoom-wrap" id="verenne-zoom-container" onmousemove="handleLensZoom(event)" onmouseleave="hideLensZoom()" ontouchmove="handleLensTouch(event)" ontouchend="hideLensZoom()">
          <img id="modal-bottle-img" src="{{ 'eclat-sauvage.jpg' | asset_url }}" alt="Formulation bottle" class="verenne-modal-img" width="600" height="750" />
          <div id="verenne-magnifier" class="verenne-magnifier-lens" style="display: none;"></div>
        </div>
      </div>

      <!-- 2. On Skin Model View -->
      <div id="verenne-view-skin" class="verenne-modal-view-panel">
        <img id="modal-skin-img" src="{{ 'model_oil_glow.jpg' | asset_url }}" alt="Formulation applied on skin" class="verenne-modal-img verenne-modal-img--skin" width="600" height="750" />
      </div>

      <!-- 3. Three.js WebGL Flacon View -->
      <div id="verenne-view-3d" class="verenne-modal-view-panel">
        <canvas id="verenne-three-canvas"></canvas>
        <p class="verenne-3d-hint">Drag to rotate flacon</p>
      </div>

      <!-- View Switcher Pills -->
      <div class="verenne-view-switcher">
        <button type="button" class="verenne-view-btn active" id="btn-view-bottle" onclick="switchVerenneView('bottle')">Bottle</button>
        <button type="button" class="verenne-view-btn" id="btn-view-skin" onclick="switchVerenneView('skin')">On skin</button>
        <button type="button" class="verenne-view-btn" id="btn-view-3d" onclick="switchVerenneView('3d')">View in 3D</button>
      </div>
    </div>

    <!-- Right Dossier Info Column -->
    <div class="verenne-modal-info-col">
      <div class="verenne-modal-header-row">
        <div class="verenne-modal-eyebrow">
          <span id="modal-no" class="verenne-eyebrow-no">N°01</span>
          <span class="verenne-eyebrow-divider"></span>
          <span id="modal-category" class="verenne-eyebrow-cat">Treat · Active botanical serum</span>
        </div>
        <button type="button" class="verenne-modal-close" onclick="closeVerenneModal()" aria-label="Close dossier">
          ✕ Close
        </button>
      </div>

      <h2 id="dossier-title" class="verenne-modal-title">Éclat Sauvage</h2>
      <p id="modal-subtitle" class="verenne-modal-subtitle">Active botanical serum</p>

      <div class="verenne-modal-reviews">
        <span class="verenne-stars">★★★★★</span>
        <span id="modal-reviews-text">4.9 · 142 reviews</span>
      </div>

      <!-- Specs Row: pH Balance & Finish -->
      <div class="verenne-modal-specs-row">
        <div class="verenne-spec-box">
          <span class="verenne-spec-label">pH Balance</span>
