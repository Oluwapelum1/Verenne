{%- comment -%}
  Verenne Featured Collection
  Full 16 Haute-Botanique Formulations from the Verenne Archive
  Includes Product Detail Modal with Bottle, On-Skin Model Portrait, and Interactive 3D Flacon
{%- endcomment -%}

<section id="collection" class="verenne-collection-section tone-light" aria-labelledby="verenne-collection-heading-{{ section.id }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="verenne-collection-container">
    <div class="verenne-collection-header">
      <div>
        {%- if section.settings.caption != blank -%}
          <p class="verenne-caption">{{ section.settings.caption | escape }}</p>
        {%- endif -%}

        <h2 id="verenne-collection-heading-{{ section.id }}" class="verenne-heading verenne-collection-title">
          {{ section.settings.title | default: 'All 16 formulations' | escape }}
        </h2>

        <p class="verenne-collection-blurb" id="verenne-cat-blurb">
          {{ section.settings.blurb | default: 'Four steps, four formulas each. Pick a step or browse them all.' | escape }}
        </p>
      </div>

      <!-- Category Filter Tabs -->
      <div class="verenne-category-tabs" role="group" aria-label="Filter by category">
        <button type="button" class="verenne-cat-btn active" onclick="filterVerenneCategory('all', this)">All Formulations</button>
        <button type="button" class="verenne-cat-btn" onclick="filterVerenneCategory('cleanse', this)">Cleanse</button>
        <button type="button" class="verenne-cat-btn" onclick="filterVerenneCategory('treat', this)">Treat</button>
        <button type="button" class="verenne-cat-btn" onclick="filterVerenneCategory('hydrate', this)">Hydrate</button>
        <button type="button" class="verenne-cat-btn" onclick="filterVerenneCategory('restore', this)">Restore</button>
